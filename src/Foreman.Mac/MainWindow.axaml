<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Foreman.Mac.ViewModels"
        xmlns:conv="using:Foreman.Mac.Converters"
        xmlns:inspector="using:Foreman.Mac.Views.Inspector"
        x:Class="Foreman.Mac.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1500"
        Height="768"
        MinWidth="900"
        MinHeight="600"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="52"
        Background="{DynamicResource Foreman.Color.WindowBackground}">
  <!-- Unified titlebar toolbar (contract #toolbar, ratified Variant B - icon+label): the OS titlebar and
       the command bar are one row, its height single-sourced from ExtendClientAreaTitleBarHeightHint below
       instead of repeating the literal. WindowDecorationMargin only ever carries a top inset on macOS, never
       a left one (gate-failure diagnosis 2026-09-03), so TrafficLightInsetConverter turns "extension is
       active" into the leading group's left-only clearance; ClipToBounds plus this row's own ZIndex keep any
       future chrome overflow from reaching the canvas below. -->
  <Grid RowDefinitions="Auto,*">
    <Grid Name="TitleBarRow" Grid.Row="0" Height="{Binding #RootWindow.ExtendClientAreaTitleBarHeightHint}"
          ColumnDefinitions="Auto,*,Auto" ClipToBounds="True" ZIndex="1"
          Background="{DynamicResource Foreman.Color.TitlebarBackground}"
          PointerPressed="OnTitleBarPointerPressed">
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                  Spacing="{StaticResource Foreman.Space.Space1}"
                  Margin="{Binding #RootWindow.WindowDecorationMargin, Converter={x:Static conv:TrafficLightInsetConverter.Instance}}">
        <Button Name="NewGraphButton" Classes="foreman-toolbar-wide" AutomationProperties.Name="New Graph" ToolTip.Tip="New Graph">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Viewbox Width="16" Height="16">
              <Canvas Width="20" Height="20">
                <Path Data="{StaticResource Foreman.Icon.New}" Classes="foreman-toolbar-glyph" Fill="{x:Null}" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="New" Classes="foreman-toolbar-label" />
          </StackPanel>
        </Button>
        <Button Name="LoadGraphButton" Classes="foreman-toolbar-wide" AutomationProperties.Name="Load" ToolTip.Tip="Load">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Viewbox Width="16" Height="16">
              <Canvas Width="20" Height="20">
                <Path Data="{StaticResource Foreman.Icon.Load}" Classes="foreman-toolbar-glyph" Fill="{x:Null}" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="Load" Classes="foreman-toolbar-label" />
          </StackPanel>
        </Button>
        <Button Name="SaveButton" Classes="foreman-toolbar-wide" Classes.on="{Binding IsDirty}"
                AutomationProperties.Name="Save" ToolTip.Tip="Save">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Viewbox Width="16" Height="16">
              <Canvas Width="20" Height="20">
                <Path Data="{StaticResource Foreman.Icon.Save}" Classes="foreman-toolbar-glyph" Fill="{x:Null}" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="Save" Classes="foreman-toolbar-label" />
          </StackPanel>
        </Button>

        <Border Classes="foreman-toolbar-separator" />

        <Button Name="AddItemButton" Classes="foreman-toolbar-wide" AutomationProperties.Name="Add Item" ToolTip.Tip="Add Item">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Viewbox Width="16" Height="16">
              <Canvas Width="20" Height="20">
                <Path Data="{StaticResource Foreman.Icon.AddItem}" Classes="foreman-toolbar-glyph" Fill="{x:Null}" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="Item" Classes="foreman-toolbar-label" />
          </StackPanel>
        </Button>
        <Button Name="AddRecipeButton" Classes="foreman-toolbar-wide" AutomationProperties.Name="Add Recipe" ToolTip.Tip="Add Recipe">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Viewbox Width="16" Height="16">
              <Canvas Width="20" Height="20">
                <Path Data="{StaticResource Foreman.Icon.AddRecipe}" Classes="foreman-toolbar-glyph" Fill="{x:Null}" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="Recipe" Classes="foreman-toolbar-label" />
          </StackPanel>
        </Button>
        <Button Name="AutoconnectButton" Classes="foreman-toolbar-wide" AutomationProperties.Name="Autoconnect" ToolTip.Tip="Autoconnect">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Viewbox Width="16" Height="16">
              <Canvas Width="20" Height="20">
                <Path Data="{StaticResource Foreman.Icon.Autoconnect}" Classes="foreman-toolbar-glyph" Fill="{x:Null}" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="Autoconnect" Classes="foreman-toolbar-label" />
          </StackPanel>
        </Button>
        <Button Name="AlignSelectionButton" Classes="foreman-toolbar-wide" AutomationProperties.Name="Align Selected" ToolTip.Tip="Align Selected">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Viewbox Width="16" Height="16">
              <Canvas Width="20" Height="20">
                <Path Data="{StaticResource Foreman.Icon.AlignSelected}" Classes="foreman-toolbar-glyph" Fill="{x:Null}" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="Align" Classes="foreman-toolbar-label" />
          </StackPanel>
        </Button>

        <Border Classes="foreman-toolbar-separator" />

        <Button Name="ExportImageButton" Classes="foreman-toolbar-wide" AutomationProperties.Name="Export Image" ToolTip.Tip="Export Image">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Viewbox Width="16" Height="16">
              <Canvas Width="20" Height="20">
                <Path Data="{StaticResource Foreman.Icon.ExportImage}" Classes="foreman-toolbar-glyph" Fill="{x:Null}" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="Export" Classes="foreman-toolbar-label" />
          </StackPanel>
        </Button>
        <Button Name="GraphSummaryButton" Classes="foreman-toolbar-wide" AutomationProperties.Name="Graph Summary" ToolTip.Tip="Graph Summary">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Viewbox Width="16" Height="16">
              <Canvas Width="20" Height="20">
                <Path Data="{StaticResource Foreman.Icon.GraphSummary}" Classes="foreman-toolbar-glyph" Fill="{x:Null}" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="Summary" Classes="foreman-toolbar-label" />
          </StackPanel>
        </Button>
        <Button Name="ViewOptionsButton" Classes="foreman-toolbar-wide" Command="{Binding ToggleViewOptionsCommand}"
                AutomationProperties.Name="View Options" ToolTip.Tip="View Options">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Viewbox Width="16" Height="16">
              <Canvas Width="20" Height="20">
                <Path Data="{StaticResource Foreman.Icon.ViewOptions}" Classes="foreman-toolbar-glyph" Fill="{x:Null}" />
                <Path Data="{StaticResource Foreman.Icon.ViewOptions.Fill}" Classes="foreman-toolbar-glyph-fill" Stroke="{x:Null}" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="View Options" Classes="foreman-toolbar-label" />
          </StackPanel>
        </Button>
      </StackPanel>

      <TextBlock Grid.Column="1" Classes="foreman-window-title"
                 Foreground="{DynamicResource Foreman.Color.Text}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><Run Text="{Binding DocumentTitle}" /><Run Text="{Binding EditedSuffix}" Foreground="{DynamicResource Foreman.Color.TextTertiary}" FontWeight="Normal" /></TextBlock>

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                  Spacing="{StaticResource Foreman.Space.Space2}" Margin="{StaticResource Foreman.Thickness.Space3}">
        <!-- Zoom stepper (contract #toolbar, marked "(new)"): −/percentage/+ over Viewport.ViewScale, bound
             to the same ZoomInCommand/ZoomOutCommand the View menu's Zoom In/Zoom Out already use (task 5) -
             one zoom path, two entry points. -->
        <Border Classes="foreman-zoom-stepper">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Name="ZoomOutButton" Classes="foreman-zoom-btn"
                    AutomationProperties.Name="Zoom Out" ToolTip.Tip="Zoom Out">
              <TextBlock Text="−" Classes="foreman-toolbar-glyph" />
            </Button>
            <TextBlock Name="ZoomValueLabel" Text="100%" Classes="foreman-zoom-value" />
            <Button Name="ZoomInButton" Classes="foreman-zoom-btn"
                    AutomationProperties.Name="Zoom In" ToolTip.Tip="Zoom In">
              <TextBlock Text="+" Classes="foreman-toolbar-glyph" />
            </Button>
          </StackPanel>
        </Border>

        <Button Name="SettingsButton" Classes="foreman-toolbar-wide" AutomationProperties.Name="Settings" ToolTip.Tip="Settings">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Viewbox Width="16" Height="16">
              <Canvas Width="20" Height="20">
                <Path Data="{StaticResource Foreman.Icon.Settings}" Classes="foreman-toolbar-glyph" Fill="{x:Null}" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="Settings" Classes="foreman-toolbar-label" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- View Options popover (contract #decisions §1 mockup: Gridlines + Graph Options group boxes fold
         into a compact rounded card anchored under ViewOptionsButton, not a full-width docked strip). A
         Popup's content isn't a Window visual descendant while closed - BindViewOptionControls and
         ResyncRateOptionsDropDown still find these controls unaffected (this.FindControl resolves through
         the compiled NameScope, which is populated at construction regardless of visual attachment); tests
         that walk the visual tree open the popover first. Fix round 2: light-dismiss like a real macOS
         popover - TwoWay so a light-dismiss close writes back to IsViewOptionsOpen instead of just the
         Popup's local value. -->
    <Popup Name="ViewOptionsPopover" PlacementTarget="{Binding #ViewOptionsButton}" Placement="Bottom"
           IsOpen="{Binding IsViewOptionsOpen, Mode=TwoWay}" IsLightDismissEnabled="True">
      <!-- Task 7: a Popup's content renders in its own popup root, outside Window.Content - but every
           size here is DynamicResource-bound, so it follows ScaleContract's token re-push on its own,
           with no popup-specific transform or registration needed. -->
      <Border Name="ViewOptionsCard" Background="{DynamicResource Foreman.Color.ControlBackground}"
              BorderBrush="{DynamicResource Foreman.Color.Border}" BorderThickness="1"
              CornerRadius="{StaticResource Foreman.Radius.Card}" Padding="{StaticResource Foreman.Thickness.Space3}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Foreman.Space.Space4}">
          <Border Name="GridLinesGroupBox" BorderBrush="{DynamicResource Foreman.Color.Border}" BorderThickness="1"
                  CornerRadius="{StaticResource Foreman.Radius.Control}" Padding="{StaticResource Foreman.Thickness.Space2}">
            <StackPanel Spacing="{StaticResource Foreman.Space.Space1}">
              <TextBlock Text="Gridlines (2n scaling)" Classes="foreman-emphasized-body" />
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Foreman.Space.Space1}">
                <TextBlock Text="Minor Gridlines:" VerticalAlignment="Center" Classes="foreman-body" />
                <ComboBox Name="MinorGridlinesDropDown">
                  <ComboBoxItem>none</ComboBoxItem>
                  <ComboBoxItem>1</ComboBoxItem>
                  <ComboBoxItem>2</ComboBoxItem>
                  <ComboBoxItem>4</ComboBoxItem>
                  <ComboBoxItem>8</ComboBoxItem>
                  <ComboBoxItem>16</ComboBoxItem>
                  <ComboBoxItem>32</ComboBoxItem>
                  <ComboBoxItem>64</ComboBoxItem>
                  <ComboBoxItem>128</ComboBoxItem>
                  <ComboBoxItem>256</ComboBoxItem>
                  <ComboBoxItem>512</ComboBoxItem>
                  <ComboBoxItem>1024</ComboBoxItem>
                </ComboBox>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Foreman.Space.Space1}">
                <TextBlock Text="Major Gridlines:" VerticalAlignment="Center" Classes="foreman-body" />
                <ComboBox Name="MajorGridlinesDropDown">
                  <ComboBoxItem>None</ComboBoxItem>
                  <ComboBoxItem>1</ComboBoxItem>
                  <ComboBoxItem>2</ComboBoxItem>
                  <ComboBoxItem>4</ComboBoxItem>
                  <ComboBoxItem>8</ComboBoxItem>
                  <ComboBoxItem>16</ComboBoxItem>
                  <ComboBoxItem>32</ComboBoxItem>
                  <ComboBoxItem>64</ComboBoxItem>
                  <ComboBoxItem>128</ComboBoxItem>
                  <ComboBoxItem>256</ComboBoxItem>
                  <ComboBoxItem>512</ComboBoxItem>
                  <ComboBoxItem>1024</ComboBoxItem>
                </ComboBox>
              </StackPanel>
              <CheckBox Name="GridlinesCheckbox" Content="Show Gridlines" />
            </StackPanel>
          </Border>

          <Border Name="ProductionGroupBox" BorderBrush="{DynamicResource Foreman.Color.Border}" BorderThickness="1"
                  CornerRadius="{StaticResource Foreman.Radius.Control}" Padding="{StaticResource Foreman.Thickness.Space2}">
            <StackPanel Spacing="{StaticResource Foreman.Space.Space1}">
              <TextBlock Text="Graph Options" Classes="foreman-emphasized-body" />
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Foreman.Space.Space1}">
                <TextBlock Text="Rate Unit:" VerticalAlignment="Center" Classes="foreman-body" />
                <ComboBox Name="RateOptionsDropDown">
                  <ComboBoxItem>1 sec</ComboBoxItem>
                  <ComboBoxItem>1 min</ComboBoxItem>
                  <ComboBoxItem>5 min</ComboBoxItem>
                  <ComboBoxItem>10 min</ComboBoxItem>
                  <ComboBoxItem>30 min</ComboBoxItem>
                  <ComboBoxItem>1 hour</ComboBoxItem>
                </ComboBox>
              </StackPanel>
              <CheckBox Name="IconViewCheckBox" Content="Icon View" />
              <CheckBox Name="PauseUpdatesCheckbox" Content="Pause all calculations" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Popup>

    <!-- Inspector's IsVisible is set from MainWindow.axaml.cs, not bound here. Overlay, not a column
         (contract §03, Jozef's live-gate ruling over the mock's own sidebar-as-column reading): the canvas
         fills the whole row, and the sidebar sits in the same cell, right-aligned and above it in z-order -
         showing or hiding it never resizes the canvas underneath. -->
    <Grid Grid.Row="1">
      <ContentControl Name="GraphViewerHost" />
      <inspector:InspectorView Name="Inspector" DataContext="{Binding Inspector}"
                                HorizontalAlignment="Right" ZIndex="1" />
    </Grid>
  </Grid>
</Window>
