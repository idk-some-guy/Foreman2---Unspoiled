<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="TextBlock.foreman-large-title">
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.LargeTitle.FontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource Foreman.Type.LargeTitle.FontWeight}" />
  </Style>

  <Style Selector="TextBlock.foreman-window-title">
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.WindowTitle.FontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource Foreman.Type.WindowTitle.FontWeight}" />
  </Style>

  <Style Selector="TextBlock.foreman-section-header">
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.SectionHeader.FontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource Foreman.Type.SectionHeader.FontWeight}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource Foreman.Type.SectionHeader.LetterSpacing}" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.TextTertiary}" />
  </Style>

  <Style Selector="TextBlock.foreman-body">
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.Body.FontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource Foreman.Type.Body.FontWeight}" />
  </Style>

  <Style Selector="TextBlock.foreman-emphasized-body">
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.EmphasizedBody.FontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource Foreman.Type.EmphasizedBody.FontWeight}" />
  </Style>

  <Style Selector="TextBlock.foreman-caption">
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.Caption.FontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource Foreman.Type.Caption.FontWeight}" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.TextTertiary}" />
  </Style>

  <!-- Unified titlebar toolbar (contract #toolbar): flat icon buttons on the titlebar surface itself,
       tinted on hover/press instead of drawing FluentTheme's default bordered chrome. -->
  <Style Selector="Button.foreman-toolbar-icon">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Foreman.Radius.Control}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.foreman-toolbar-wide">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Foreman.Radius.Control}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.foreman-toolbar-icon:pointerover /template/ ContentPresenter, Button.foreman-toolbar-wide:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackgroundHover}" />
  </Style>

  <!-- Save's dirty-state accent tint (contract #toolbar's .on state) - IsDirty toggles this class. Every
       action button is the wide (icon+label) form now (task 8), so .on targets foreman-toolbar-wide;
       foreman-toolbar-icon itself stays defined above for GalleryWindow's icon-only showcase tile. -->
  <Style Selector="Button.foreman-toolbar-wide.on">
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.AccentSoft}" />
  </Style>
  <Style Selector="Button.foreman-toolbar-wide.on Path.foreman-toolbar-glyph">
    <Setter Property="Stroke" Value="{DynamicResource Foreman.Color.Accent}" />
  </Style>

  <!-- M-5 (final fix wave): the plain :pointerover rule above sets ContentPresenter.Background directly,
       which outranks .on's Background setter on the Button itself (the template's ContentPresenter only
       inherits that one via TemplateBinding) - so hovering a dirty Save button used to swap the accent
       tint for the generic hover gray. This selector targets the same ContentPresenter .on does, with one
       more qualifier than the plain hover rule, so the accent wins while still hovered. -->
  <Style Selector="Button.foreman-toolbar-wide.on:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.AccentSoft}" />
  </Style>

  <!-- Task 8 (contract #toolbar mock's own <svg>): the toolbar glyphs are vector paths now, not font
       characters - the zoom stepper's −/+ stay TextBlock, so that selector is untouched below. -->
  <Style Selector="TextBlock.foreman-toolbar-glyph">
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.EmphasizedBody.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Path.foreman-toolbar-glyph">
    <Setter Property="Stroke" Value="{DynamicResource Foreman.Color.TextSecondary}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>

  <Style Selector="Path.foreman-toolbar-glyph-fill">
    <Setter Property="Fill" Value="{DynamicResource Foreman.Color.TextSecondary}" />
  </Style>

  <Style Selector="TextBlock.foreman-toolbar-label">
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.ToolbarLabel.FontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource Foreman.Type.ToolbarLabel.FontWeight}" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.foreman-toolbar-separator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.BorderStrong}" />
  </Style>

  <!-- Zoom stepper (contract #toolbar, marked "(new)") -->
  <Style Selector="Border.foreman-zoom-stepper">
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="2" />
  </Style>

  <Style Selector="Button.foreman-zoom-btn">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.foreman-zoom-btn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackgroundHover}" />
  </Style>

  <Style Selector="TextBlock.foreman-zoom-value">
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.Body.FontSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.TextSecondary}" />
    <Setter Property="Width" Value="46" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Reuses the zoom stepper's rounded-border shape above - no dedicated segmented control exists yet. -->
  <Style Selector="TextBlock.foreman-inspector-title">
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.InspectorTitle.FontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource Foreman.Type.InspectorTitle.FontWeight}" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.Text}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- Task 9: subtitle reads tertiary, not secondary - the mock's .insp-identity .sub color. -->
  <Style Selector="TextBlock.foreman-inspector-subtitle">
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.InspectorSubtitle.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.TextTertiary}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- Identity header (Task 9, contract §03 CSS 363-381): padding 12, 1px bottom border, the icon well
       sitting left of name/subtitle/quality mini-select. -->
  <Style Selector="Border.foreman-identity-row">
    <Setter Property="Padding" Value="{DynamicResource Foreman.Thickness.Space3}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="Border.foreman-identity-icon">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Quality mini-select (Task 9, contract §03 CSS 691-703): a compact popup button under the identity
       name/subtitle, left-aligned - replaces the old top-right "Quality" button. -->
  <Style Selector="Button.foreman-mini-select">
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.WellBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Foreman.Radius.Control}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Width" Value="126" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="TextBlock.foreman-mini-select-text">
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.SmallBody.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.Text}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Shared by the mini-select dropdown, InspectorGroup headers, and CompactStepper's arrows. -->
  <Style Selector="Path.foreman-chevron">
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="{DynamicResource Foreman.Color.TextTertiary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Recipe card (Task 9, contract §03 CSS 708-718): folds the old hover tooltip into the identity
       header - ingredients -> arrow -> products, wrapping, then a crafting-time/base-rate meta row. -->
  <Style Selector="Border.foreman-recipe-card">
    <Setter Property="Margin" Value="12,2,12,4" />
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.WellBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="11,10" />
  </Style>

  <Style Selector="Border.foreman-recipe-card-icon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="TextBlock.foreman-recipe-card-flow-text">
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.SmallBody.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.Text}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.foreman-recipe-card-arrow">
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.SmallBody.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.TextTertiary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="StackPanel.foreman-recipe-card-flow-item">
    <Setter Property="Margin" Value="0,0,6,4" />
  </Style>

  <!-- Mini segmented control (Task 9, contract §03 CSS 429-437): the per-row Auto/Fixed toggle - same
       well-background pill as the top-level Recipe/Flow segmented strip, but its active state is neutral
       (control background + plain text), not accented, and it stays inline rather than full width. -->
  <Style Selector="Border.foreman-seg-mini">
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.WellBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Foreman.Radius.Control}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style Selector="RadioButton.foreman-seg-mini-item">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.TextSecondary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                             Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="RadioButton.foreman-seg-mini-item:checked">
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.Text}" />
  </Style>

  <!-- Picker row (Task 9, contract §03 CSS 411-418): Assembler/Beacon's selected-item row. -->
  <Style Selector="StackPanel.foreman-picker-row">
    <Setter Property="Spacing" Value="8" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>

  <Style Selector="Border.foreman-picker-icon">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="{DynamicResource Foreman.Radius.Control}" />
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="TextBlock.foreman-picker-name">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.Text}" />
  </Style>

  <!-- Field note (Task 9, contract §03 CSS 463): 10.5px tertiary hint text under a pick grid. -->
  <Style Selector="TextBlock.foreman-field-note">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.TextTertiary}" />
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>

  <!-- Row label (Task 9, contract §03 CSS 400-409): 12.5px, left-aligned in a label/value row that
       pushes its stepper or toggle to the trailing edge. -->
  <Style Selector="TextBlock.foreman-row-label">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Row spacing (Task 9 gate-fix 2, mock CSS 400/452): each row grid carries its own vertical margin. -->
  <Style Selector="Grid.foreman-toggle-row">
    <Setter Property="Margin" Value="0,5" />
  </Style>

  <Style Selector="Grid.foreman-insp-row">
    <Setter Property="Margin" Value="0,4" />
  </Style>

  <!-- Compact stepper (Task 9, contract §03 CSS 439-450): NumericUpDown's own Fluent chrome can't reach
       this shape without retemplating internals we don't own, so CompactStepper (Views/Inspector) builds
       its own TextBox+arrow-button template instead - these style its parts. -->
  <Style Selector="Border.foreman-stepper">
    <Setter Property="Height" Value="22" />
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Foreman.Radius.Control}" />
  </Style>

  <Style Selector="Border.foreman-stepper:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="TextBox.foreman-stepper-value">
    <Setter Property="Width" Value="52" />
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.SmallBody.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.Text}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.foreman-stepper-arrows">
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.Border}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>

  <Style Selector="Button.foreman-stepper-arrow">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="11" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.TextTertiary}" />
    <Setter Property="FontSize" Value="7" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.foreman-stepper-arrow-top">
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <!-- Toggle row switch (Task 9, contract §03 CSS 453-461): a plain ToggleSwitch with OnContent/
       OffContent cleared in the view (no "On"/"Off" text) and its own pill template - Fluent's default
       ToggleSwitch chrome is a full labelled control, not this bare 30x18 pill. -->
  <Style Selector="ToggleSwitch.foreman-mini-switch">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Named PillTrack, not FluentTheme's own "SwitchKnobBounds" - that name still carries FluentTheme's
             built-in ^:unchecked/^:checked Opacity 0/1 toggling (its ControlTheme applies regardless of our
             Template override), which hid this track whenever the switch was off. -->
        <Border Name="PillTrack" Width="30" Height="18" CornerRadius="10"
                Background="{DynamicResource Foreman.Color.BorderStrong}">
          <!-- ToggleSwitch requires a part named PART_MovingKnobs (AVLN2205) - this pill's own thumb
               fills that role, restyled well past its Fluent-default look. The panel just satisfies the
               required name; SwitchKnob's own HorizontalAlignment (toggled below) does the sliding. -->
          <Panel Name="PART_MovingKnobs">
            <Border Name="SwitchKnob" Width="14" Height="14" CornerRadius="7" Background="White"
                    Margin="2,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="ToggleSwitch.foreman-mini-switch:checked /template/ Border#PillTrack">
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.Accent}" />
  </Style>

  <Style Selector="ToggleSwitch.foreman-mini-switch:checked /template/ Border#SwitchKnob">
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>

  <!-- Task 4's Auto/Fixed rate toggle: a RadioButton flattened to a pill look, its bullet indicator
       replaced with a plain content border. -->
  <Style Selector="RadioButton.foreman-segment-item">
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.ToolbarLabel.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.TextSecondary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="CornerRadius" Value="{DynamicResource Foreman.Radius.Control}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                             Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="RadioButton.foreman-segment-item:checked">
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.Accent}" />
  </Style>

  <!-- PickGrid cell (Task 5): a plain Button carries this class per rendered item, with .selected/
       .unavailable toggled from PickGridItem.IsSelected/IsAvailable. -->
  <Style Selector="Button.foreman-pick-cell">
    <Setter Property="Width" Value="{DynamicResource Foreman.Size.PickCell}" />
    <Setter Property="Height" Value="{DynamicResource Foreman.Size.PickCell}" />
    <Setter Property="Margin" Value="{DynamicResource Foreman.Thickness.PickCellGap}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.PickCellBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Foreman.Radius.PickCell}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.foreman-pick-cell.selected">
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.PickCellSelected}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.Accent}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource Foreman.Shadow.PickSelectedRing}">
          <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.foreman-pick-cell.unavailable">
    <Setter Property="Opacity" Value="0.4" />
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.Error}" />
  </Style>

  <!-- InspectorGroup's title row (Task 6): flat, full-width, left-aligned like foreman-toolbar-wide -
       clicking it (or Enter/Space while focused) toggles IsExpanded. -->
  <Style Selector="Button.foreman-group-header">
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Foreman.Radius.Control}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>

  <Style Selector="Button.foreman-group-header:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackgroundHover}" />
  </Style>

  <!-- .last (set on whichever group is visually last) drops the bottom border. -->
  <Style Selector="Border.foreman-inspector-group">
    <Setter Property="Padding" Value="12,10,12,14" />
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="Border.foreman-inspector-group.last">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Border.foreman-qa-panel">
    <Setter Property="Width" Value="{DynamicResource Foreman.Size.PaletteWidth}" />
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.InspectorBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Foreman.Radius.Window}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Foreman.Shadow.Popover}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.foreman-qa-search-row">
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style Selector="TextBox.foreman-qa-search">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.Body.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.Text}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.foreman-qa-row-icon">
    <Setter Property="Width" Value="{DynamicResource Foreman.Size.PaletteRowIcon}" />
    <Setter Property="Height" Value="{DynamicResource Foreman.Size.PaletteRowIcon}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Foreman.Radius.PickCell}" />
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.foreman-qa-row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="CornerRadius" Value="{DynamicResource Foreman.Radius.Control}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Button.foreman-qa-row.top">
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.AccentSoft}" />
  </Style>

  <Style Selector="Button.foreman-qa-row:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackgroundHover}" />
  </Style>

  <Style Selector="TextBlock.foreman-qa-row-name">
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.Palette.Row.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.Text}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.foreman-qa-row-sub">
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.Palette.Sub.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.TextTertiary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>

  <Style Selector="Border.foreman-qa-hint-row">
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.Border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="12,7" />
  </Style>

  <Style Selector="TextBlock.foreman-qa-hint-text">
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.Palette.Hint.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.TextTertiary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.foreman-kbd">
    <Setter Property="MinWidth" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.Border}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="TextBlock.foreman-kbd-text">
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.Kbd.FontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.TextSecondary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Radial menu (C2b link-drag chooser, reference §11): ".hover" is toggled from code, not :pointerover. -->
  <Style Selector="Path.foreman-radial-slice">
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="Transparent" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>
  <Style Selector="Path.foreman-radial-slice.hover">
    <Setter Property="Fill" Value="{DynamicResource Foreman.Color.AccentSoft}" />
    <Setter Property="Stroke" Value="{DynamicResource Foreman.Color.Accent}" />
  </Style>

  <Style Selector="Ellipse.foreman-radial-hub">
    <Setter Property="Fill" Value="{DynamicResource Foreman.Color.WellBackground}" />
    <Setter Property="Stroke" Value="{DynamicResource Foreman.Color.BorderStrong}" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>

  <Style Selector="Ellipse.foreman-radial-cursor">
    <Setter Property="Fill" Value="{DynamicResource Foreman.Color.Accent}" />
  </Style>

  <Style Selector="Path.foreman-radial-icon">
    <Setter Property="Stroke" Value="{DynamicResource Foreman.Color.TextSecondary}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="Path.foreman-radial-icon.hover">
    <Setter Property="Stroke" Value="{DynamicResource Foreman.Color.AccentText}" />
  </Style>

  <Style Selector="TextBlock.foreman-radial-label">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.foreman-radial-label.hover">
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.AccentText}" />
  </Style>

  <!-- "Add to Graph" browser window (Task 5, contract #chooser). -->
  <Style Selector="Border.foreman-browser-toolbar">
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.WellBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <Style Selector="TextBox.foreman-search-field">
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Foreman.Radius.SearchField}" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.SearchField.FontSize}" />
  </Style>

  <Style Selector="Button.foreman-browser-group">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Foreman.Radius.Control}" />
    <Setter Property="Padding" Value="6,8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.Browser.Row.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.TextSecondary}" />
  </Style>

  <Style Selector="Button.foreman-browser-group:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackgroundHover}" />
  </Style>

  <Style Selector="Button.foreman-browser-group.selected">
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.Accent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.foreman-browser-subhead">
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.Browser.Subhead.FontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.44" />
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.TextTertiary}" />
  </Style>

  <Style Selector="Button.foreman-browser-cell">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="CornerRadius" Value="{DynamicResource Foreman.Radius.Control}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.foreman-browser-cell:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackgroundHover}" />
  </Style>

  <Style Selector="Button.foreman-browser-cell.selected">
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.AccentSoft}" />
  </Style>

  <Style Selector="Button.foreman-browser-cell.unavailable">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="Border.foreman-browser-cell-icon">
    <Setter Property="CornerRadius" Value="{DynamicResource Foreman.Radius.Control}" />
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="4" />
  </Style>

  <Style Selector="TextBlock.foreman-browser-cell-label">
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.Browser.Label.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.TextSecondary}" />
    <Setter Property="MaxWidth" Value="{DynamicResource Foreman.Size.BrowserCellPitch}" />
    <Setter Property="Height" Value="{DynamicResource Foreman.Size.BrowserCellLabelHeight}" />
    <Setter Property="MaxLines" Value="2" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="Border.foreman-browser-footer">
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.WellBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.Border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <!-- Footer role buttons (Task 6, contract #chooser .cf-btn): Source/Pass-Through/Output and
       UnSpoil/UnPlant/Spoil/Plant, IsVisible-bound per item so an inapplicable role just isn't there. -->
  <Style Selector="Button.foreman-browser-role">
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.WellBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Foreman.Radius.Control}" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.Browser.Row.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.TextSecondary}" />
  </Style>

  <Style Selector="Button.foreman-browser-role:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackgroundHover}" />
  </Style>

  <!-- Filter chip (Task 6, contract #chooser .filter-chip): "Compatible with {item}"/"Origins of {item}". -->
  <Style Selector="Border.foreman-filter-chip">
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.AccentSoft}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Foreman.Radius.Control}" />
    <Setter Property="Padding" Value="10,5" />
  </Style>

  <Style Selector="TextBlock.foreman-filter-chip-text">
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.Browser.Row.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.Accent}" />
  </Style>

  <Style Selector="Button.foreman-filter-chip-x">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.Browser.Row.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.Accent}" />
  </Style>

</Styles>
