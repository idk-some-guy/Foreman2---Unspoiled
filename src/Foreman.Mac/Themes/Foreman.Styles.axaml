<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="TextBlock.foreman-large-title">
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.LargeTitle.FontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource Foreman.Type.LargeTitle.FontWeight}" />
  </Style>

  <!-- C2c Task 4: SettingsWindow's toolbar-tab strip (reference phase9-ui-proposal-RATIFIED.html §06.3
       .settings-tab/.active) - icon above label, active tab tinted with the accent-soft pairing. -->
  <Style Selector="Button.foreman-settings-tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Foreman.Radius.Control}" />
    <Setter Property="Padding" Value="13,6" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.TextSecondary}" />
  </Style>
  <Style Selector="Button.foreman-settings-tab:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackgroundHover}" />
  </Style>
  <Style Selector="Button.foreman-settings-tab.active">
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.Accent}" />
  </Style>
  <Style Selector="Button.foreman-settings-tab.active Path.foreman-toolbar-glyph">
    <Setter Property="Stroke" Value="{DynamicResource Foreman.Color.Accent}" />
  </Style>
  <Style Selector="TextBlock.foreman-settings-tab-label">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- Path.foreman-toolbar-glyph stays: SettingsWindow's tab strip still consumes it. -->
  <Style Selector="Path.foreman-toolbar-glyph">
    <Setter Property="Stroke" Value="{DynamicResource Foreman.Color.TextSecondary}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>

</Styles>
