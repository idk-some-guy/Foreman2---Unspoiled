<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="Foreman.Color.CanvasBackground">#FAFAFA</Color>
  <Color x:Key="Foreman.Color.WindowBackground">#ECECEF</Color>
  <Color x:Key="Foreman.Color.TitlebarBackground">#E7E7EA</Color>
  <Color x:Key="Foreman.Color.SidebarBackground">#EFEFF1</Color>
  <Color x:Key="Foreman.Color.ControlBackground">#FFFFFF</Color>
  <Color x:Key="Foreman.Color.ControlBackgroundHover">#F5F5F6</Color>
  <Color x:Key="Foreman.Color.WellBackground">#FFFFFF</Color>
  <Color x:Key="Foreman.Color.Border">#17000000</Color>
  <Color x:Key="Foreman.Color.BorderStrong">#24000000</Color>
  <Color x:Key="Foreman.Color.Text">#E0000000</Color>
  <Color x:Key="Foreman.Color.TextSecondary">#8C000000</Color>
  <Color x:Key="Foreman.Color.TextTertiary">#57000000</Color>
  <Color x:Key="Foreman.Color.Accent">#0068DA</Color>
  <Color x:Key="Foreman.Color.AccentSoft">#1F0068DA</Color>
  <Color x:Key="Foreman.Color.Selection">#D97A06</Color>
  <Color x:Key="Foreman.Color.Error">#D70015</Color>

  <!-- Status tokens: existing availability/similarity row coloring (GraphSummary, Comparator,
       Enabled Objects), not part of the phase 9 visual-language contract - see task-2-report.md. -->
  <Color x:Key="Foreman.Color.StatusForeground">#000000</Color>
  <Color x:Key="Foreman.Color.StatusWarningForeground">#8B0000</Color>
  <Color x:Key="Foreman.Color.StatusWarningBackground">#FFC0CB</Color>
  <Color x:Key="Foreman.Color.StatusCautionBackground">#F0E68C</Color>

  <x:Double x:Key="Foreman.Space.Space1">4</x:Double>
  <x:Double x:Key="Foreman.Space.Space2">8</x:Double>
  <x:Double x:Key="Foreman.Space.Space3">12</x:Double>
  <x:Double x:Key="Foreman.Space.Space4">16</x:Double>
  <x:Double x:Key="Foreman.Space.Space5">24</x:Double>
  <x:Double x:Key="Foreman.Space.Space6">32</x:Double>
  <x:Double x:Key="Foreman.Space.RadiusControl">6</x:Double>
  <x:Double x:Key="Foreman.Space.RadiusCard">9</x:Double>
  <x:Double x:Key="Foreman.Space.RadiusWindow">11</x:Double>
  <x:Double x:Key="Foreman.Space.PickerCell">26</x:Double>

  <!-- Typed companions of the Space/Radius doubles above, same numbers: CornerRadius and
       Thickness (Margin/Padding) properties reject a boxed x:Double resource at style-application
       time, so anything binding those properties needs its own typed resource instead. -->
  <Thickness x:Key="Foreman.Thickness.Space1">4</Thickness>
  <Thickness x:Key="Foreman.Thickness.Space2">8</Thickness>
  <Thickness x:Key="Foreman.Thickness.Space3">12</Thickness>
  <Thickness x:Key="Foreman.Thickness.Space4">16</Thickness>
  <Thickness x:Key="Foreman.Thickness.Space5">24</Thickness>
  <Thickness x:Key="Foreman.Thickness.Space6">32</Thickness>
  <CornerRadius x:Key="Foreman.Radius.Control">6</CornerRadius>
  <CornerRadius x:Key="Foreman.Radius.Card">9</CornerRadius>
  <CornerRadius x:Key="Foreman.Radius.Window">11</CornerRadius>

  <x:Double x:Key="Foreman.Type.LargeTitle.FontSize">20</x:Double>
  <FontWeight x:Key="Foreman.Type.LargeTitle.FontWeight">700</FontWeight>
  <x:Double x:Key="Foreman.Type.WindowTitle.FontSize">13</x:Double>
  <FontWeight x:Key="Foreman.Type.WindowTitle.FontWeight">600</FontWeight>
  <x:Double x:Key="Foreman.Type.SectionHeader.FontSize">11</x:Double>
  <FontWeight x:Key="Foreman.Type.SectionHeader.FontWeight">650</FontWeight>
  <x:Double x:Key="Foreman.Type.SectionHeader.LetterSpacing">0.33</x:Double>
  <x:Double x:Key="Foreman.Type.Body.FontSize">13</x:Double>
  <FontWeight x:Key="Foreman.Type.Body.FontWeight">400</FontWeight>
  <x:Double x:Key="Foreman.Type.EmphasizedBody.FontSize">13</x:Double>
  <FontWeight x:Key="Foreman.Type.EmphasizedBody.FontWeight">600</FontWeight>
  <x:Double x:Key="Foreman.Type.Caption.FontSize">11</x:Double>
  <FontWeight x:Key="Foreman.Type.Caption.FontWeight">400</FontWeight>

</ResourceDictionary>
