<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Merged into Application.Resources via App.axaml's ResourceInclude, not a StyleInclude here - StaticResource can't cross a StyleInclude boundary to reach MainWindow.axaml. -->

  <!-- Down-pointing chevron ribbon; every inspector disclosure/dropdown/stepper arrow rotates this one shape. -->
  <StreamGeometry x:Key="Foreman.Icon.Chevron">M1,1 L6,6 L11,1 L11,3.4 L6,8.4 L1,3.4 Z</StreamGeometry>

  <!-- Magnifying glass (Quick Add palette / browser search field), stroked like foreman-toolbar-glyph. -->
  <StreamGeometry x:Key="Foreman.Icon.Search">M3,8.2 A5.2,5.2 0 1,1 13.4,8.2 A5.2,5.2 0 1,1 3,8.2 Z M15,15 L11.7,11.7</StreamGeometry>

  <!-- Radial menu slice icons (C2b's link-drag chooser, reference §11). -->
  <StreamGeometry x:Key="Foreman.Icon.RadialAdd">M9.5,3 v13 M3,9.5 h13</StreamGeometry>
  <StreamGeometry x:Key="Foreman.Icon.RadialPassthrough">M2,9.5 H6.5 M12.5,9.5 H17 M6.5,9.5 A3,3 0 1,0 12.5,9.5 A3,3 0 1,0 6.5,9.5 Z</StreamGeometry>
  <StreamGeometry x:Key="Foreman.Icon.RadialCancel">M4,4 L15,15 M15,4 L4,15</StreamGeometry>
  <StreamGeometry x:Key="Foreman.Icon.RadialSource">M15,3 V16 M2,9.5 H12 M8,5 L12,9.5 L8,14</StreamGeometry>
  <StreamGeometry x:Key="Foreman.Icon.RadialOutput">M4,3 V16 M7,9.5 H17 M13,5 L17,9.5 L13,14</StreamGeometry>
  <StreamGeometry x:Key="Foreman.Icon.RadialSpoil">M9.5,2 V11 M5,7 L9.5,11 L14,7 M4,14 Q7,12 9.5,14 Q12,16 15,14</StreamGeometry>
  <StreamGeometry x:Key="Foreman.Icon.RadialUnspoil">M9.5,17 V8 M5,12 L9.5,8 L14,12 M4,5 Q7,7 9.5,5 Q12,3 15,5</StreamGeometry>
  <StreamGeometry x:Key="Foreman.Icon.RadialPlant">M9.5,17 V8 M9.5,10 Q5,9 4,4 M9.5,10 Q14,9 15,4</StreamGeometry>
  <StreamGeometry x:Key="Foreman.Icon.RadialUnplant">M9.5,2 V11 M9.5,9 Q5,10 4,15 M9.5,9 Q14,10 15,15</StreamGeometry>

  <!-- Settings window's toolbar-tab strip (C2c Task 4, reference phase9-ui-proposal-RATIFIED.html §06.3). -->
  <StreamGeometry x:Key="Foreman.Icon.Settings.Presets">M3,4 h14 v4 h-14 Z M3,10 h14 v6 h-14 Z</StreamGeometry>
  <StreamGeometry x:Key="Foreman.Icon.Settings.EnabledObjects">M4,6 h9 M4,10 h9 M4,14 h6 M15,13 l1.3,1.3 L19,11.6</StreamGeometry>
  <StreamGeometry x:Key="Foreman.Icon.Settings.General">M7.4,10 A2.6,2.6 0 1,0 12.6,10 A2.6,2.6 0 1,0 7.4,10 Z M10,3.5 v2 M10,14.5 v2 M3.5,10 h2 M14.5,10 h2 M5.6,5.6 l1.4,1.4 M13,13 l1.4,1.4 M5.6,14.4 L7,13 M13,7 l1.4,-1.4</StreamGeometry>
  <StreamGeometry x:Key="Foreman.Icon.Settings.Advanced">M13,3.5 L16.5,7 L8,15.5 L4,16 L4.5,12 Z</StreamGeometry>
  <StreamGeometry x:Key="Foreman.Icon.Settings.Annotations">M3,4 h14 v10 h-14 Z M6,17 h4</StreamGeometry>
  <StreamGeometry x:Key="Foreman.Icon.Settings.Appearance">M3.5,10 A6.5,6.5 0 1,0 16.5,10 A6.5,6.5 0 1,0 3.5,10 Z</StreamGeometry>
</ResourceDictionary>
