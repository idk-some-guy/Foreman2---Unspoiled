<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Foreman.Mac.App"
             Name="Foreman 2"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Foreman.Mac.Kit/Kit.axaml" />
        <ResourceInclude Source="avares://Foreman.Mac/Themes/ToolbarIcons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Foreman.Mac/Themes/Foreman.Styles.axaml" />
  </Application.Styles>
</Application>
