<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Foreman.Mac.Views.MessageDialog"
        Width="360"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SystemChromeMediumColor}">
  <StackPanel Margin="16" Spacing="16">
    <TextBlock Name="MessageTextBlock" TextWrapping="Wrap" />
    <Button Name="OkButton" Content="OK" HorizontalAlignment="Right" Click="OnOkClick" />
  </StackPanel>
</Window>
