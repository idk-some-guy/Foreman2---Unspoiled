<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Foreman.Mac.Views.ShapePropertiesWindow"
        Title="Shape Properties"
        Width="340"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SystemChromeMediumColor}">
  <StackPanel Margin="16" Spacing="10">
    <ComboBox Name="ShapeTypeCombo" HorizontalAlignment="Stretch" />

    <CheckBox Name="NoFillCheckBox" Content="No fill" />
    <TextBlock Text="Fill color" FontWeight="Bold" />
    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto">
      <NumericUpDown Name="FillColorRedInput" Grid.Column="0" Width="72" Minimum="0" Maximum="255" />
      <NumericUpDown Name="FillColorGreenInput" Grid.Column="1" Width="72" Minimum="0" Maximum="255" />
      <NumericUpDown Name="FillColorBlueInput" Grid.Column="2" Width="72" Minimum="0" Maximum="255" />
      <Border Name="FillColorSwatch" Grid.Column="3" Width="28" Height="28" Margin="8,0,0,0" BorderBrush="Gray" BorderThickness="1" />
    </Grid>
    <Grid ColumnDefinitions="Auto,*">
      <TextBlock Name="FillAlphaLabel" Grid.Column="0" Text="Fill alpha: 255" VerticalAlignment="Center" Width="110" />
      <Slider Name="FillAlphaTrack" Grid.Column="1" Minimum="0" Maximum="255" />
    </Grid>

    <TextBlock Text="Border color" FontWeight="Bold" />
    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto">
      <NumericUpDown Name="BorderColorRedInput" Grid.Column="0" Width="72" Minimum="0" Maximum="255" />
      <NumericUpDown Name="BorderColorGreenInput" Grid.Column="1" Width="72" Minimum="0" Maximum="255" />
      <NumericUpDown Name="BorderColorBlueInput" Grid.Column="2" Width="72" Minimum="0" Maximum="255" />
      <Border Name="BorderColorSwatch" Grid.Column="3" Width="28" Height="28" Margin="8,0,0,0" BorderBrush="Gray" BorderThickness="1" />
    </Grid>

    <Grid ColumnDefinitions="Auto,*">
      <TextBlock Text="Border width" Grid.Column="0" VerticalAlignment="Center" Width="110" />
      <NumericUpDown Name="BorderWidthInput" Grid.Column="1" Minimum="0" Maximum="50" Increment="1" HorizontalAlignment="Left" Width="100" />
    </Grid>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Name="CancelButton" Content="Cancel" />
      <Button Name="OKButton" Content="OK" />
    </StackPanel>
  </StackPanel>
</Window>
