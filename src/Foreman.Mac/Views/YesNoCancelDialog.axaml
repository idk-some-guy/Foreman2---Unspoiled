<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Foreman.Mac.Views.YesNoCancelDialog"
        Width="360"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SystemChromeMediumColor}">
  <StackPanel Margin="16" Spacing="16">
    <TextBlock Name="MessageTextBlock" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Name="CancelButton" Content="Cancel" />
      <Button Name="NoButton" Content="No" />
      <Button Name="YesButton" Content="Yes" />
    </StackPanel>
  </StackPanel>
</Window>
