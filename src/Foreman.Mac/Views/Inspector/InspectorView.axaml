<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Foreman.Mac.ViewModels"
             xmlns:composites="using:Foreman.Mac.Kit.Composites"
             xmlns:ctrl="using:Foreman.Mac.Kit.Controls"
             x:Class="Foreman.Mac.Views.Inspector.InspectorView"
             x:DataType="vm:InspectorViewModel">
  <!-- IsVisible is driven from MainWindow.axaml.cs (ViewModel.IsInspectorVisible), not a binding here -
       InspectorView's own DataContext is the nested Inspector view model, not MainWindowViewModel, and
       compiled bindings can't cross that boundary from a XAML attribute on this same element. Overlay,
       not a column (contract §03): MainWindow sits this Border in the same grid cell as the
       canvas, right-aligned above it - this Border owns its own soft left shadow instead of relying on
       a reserved column to separate it from the canvas; the split divider draws the boundary hairline. -->
  <Border Width="{Binding Width}"
          Background="{DynamicResource Foreman.Color.InspectorBackground}"
          BoxShadow="{DynamicResource Foreman.Shadow.Sidebar}">
    <Grid ColumnDefinitions="Auto,*">
      <composites:SplitDivider Grid.Column="0" Name="WidthDivider" Theme="{StaticResource Kit.SplitDivider}"
                                Anchor="Trailing" Value="{Binding Width, Mode=TwoWay}" />
      <Grid Grid.Column="1" RowDefinitions="Auto,*">
        <Border Grid.Row="0" Name="IdentityRow" Padding="12,11" IsVisible="{Binding HasNode}"
                BorderBrush="{DynamicResource Foreman.Color.Border}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="Auto,10,*">
            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="7"
                    Background="{DynamicResource Foreman.Color.ControlBackground}"
                    BorderBrush="{DynamicResource Foreman.Color.BorderStrong}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <Image Name="IdentityIcon" Width="17" Height="17" />
            </Border>
            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
              <TextBlock Name="IdentityName" Theme="{StaticResource Kit.Text}" Classes="headline"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Name="IdentitySubtitle" Theme="{StaticResource Kit.Text}" Classes="caption tertiary"
                         TextTrimming="CharacterEllipsis" />
              <StackPanel Name="QualityRow" Orientation="Horizontal" Spacing="4" IsVisible="False" Margin="0,4,0,0">
                <Image Name="QualityIcon" Width="16" Height="16" />
                <ctrl:PopUp Name="QualityMiniSelect" Theme="{StaticResource Kit.PopUp}" HorizontalAlignment="Left" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Only the body scrolls - the identity header above stays pinned. Named so tests can find this
             specific ScrollViewer, not one buried in a TextBox's own template part. -->
        <ScrollViewer Grid.Row="1" Name="InspectorScroller">
          <ContentControl Name="SegmentHost" IsVisible="{Binding HasNode}" />
        </ScrollViewer>
        <composites:StatePanel Grid.Row="1" Name="EmptyState" Theme="{StaticResource Kit.StatePanel}"
                                Shape="Empty" Headline="No node selected"
                                Sentence="Select a node on the canvas to edit its recipe, building and modules."
                                IsVisible="{Binding !HasNode}" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
