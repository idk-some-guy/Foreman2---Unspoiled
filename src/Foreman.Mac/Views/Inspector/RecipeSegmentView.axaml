<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Foreman.Mac.ViewModels"
             xmlns:insp="using:Foreman.Mac.Views.Inspector"
             xmlns:kit="using:Foreman.Mac.Kit.Composites"
             xmlns:ctrl="using:Foreman.Mac.Kit.Controls"
             x:Class="Foreman.Mac.Views.Inspector.RecipeSegmentView"
             x:DataType="vm:RecipeSegmentViewModel">
  <StackPanel Spacing="0">
    <kit:InspectorGroup Header="Recipe" Theme="{StaticResource Kit.InspectorGroup}">
      <Grid>
        <ContentControl IsVisible="{Binding HasCard}">
          <insp:RecipeCardView Name="RecipeCard" DataContext="{Binding Card}" />
        </ContentControl>
        <kit:StatePanel Name="RecipeErrorPanel" Theme="{StaticResource Kit.StatePanel}" Shape="Error"
                         Headline="Recipe missing from this preset"
                         Sentence="The current preset has no recipe by this name, so this node cannot be solved."
                         IsVisible="{Binding HasRecipeError}" />
      </Grid>
    </kit:InspectorGroup>

    <Border Classes="foreman-inspector-group-rule" Height="1" Background="{DynamicResource Foreman.Color.Border}" />

    <kit:InspectorGroup Header="Rate" Theme="{StaticResource Kit.InspectorGroup}">
      <kit:FormGroup Theme="{StaticResource Kit.FormGroup}">
        <kit:FormRow Theme="{StaticResource Kit.FormRow}" Label="Mode" LabelColumn="Inspector">
          <ctrl:Segmented Name="RateMode" Theme="{StaticResource Kit.Segmented}" Classes="mini" />
        </kit:FormRow>
        <kit:FormRow Theme="{StaticResource Kit.FormRow}" Label="Buildings" LabelColumn="Inspector">
          <ctrl:Stepper Name="AssemblerCountValue" Theme="{StaticResource Kit.Stepper}" Minimum="0" Decimals="2"
                        IsEnabled="{Binding IsFixedRate}" Value="{Binding AssemblerCount, Mode=TwoWay}" />
        </kit:FormRow>
        <kit:FormRow Theme="{StaticResource Kit.FormRow}" Label="Options" LabelColumn="Inspector">
          <StackPanel Spacing="2">
            <CheckBox Name="LowPriority" Theme="{StaticResource Kit.CheckBox}" Content="Low-priority recipe"
                      IsChecked="{Binding LowPriority, Mode=TwoWay}" />
            <CheckBox Name="KeyNode" Theme="{StaticResource Kit.CheckBox}" Content="Key node"
                      IsChecked="{Binding IsKeyNode, Mode=TwoWay}" />
          </StackPanel>
        </kit:FormRow>
        <kit:FormRow Theme="{StaticResource Kit.FormRow}" LabelColumn="Inspector" IsVisible="{Binding IsKeyNode}">
          <TextBox Name="KeyNodeTitle" MaxLength="200" Text="{Binding KeyNodeTitle, Mode=TwoWay}" />
        </kit:FormRow>
      </kit:FormGroup>
    </kit:InspectorGroup>

    <Border Classes="foreman-inspector-group-rule" Height="1" Background="{DynamicResource Foreman.Color.Border}" />

    <kit:InspectorGroup Header="Assembler" Theme="{StaticResource Kit.InspectorGroup}">
      <StackPanel Spacing="0">
        <StackPanel Orientation="Horizontal" Classes="foreman-picker-row">
          <Border Classes="foreman-picker-icon">
            <Image Name="SelectedAssemblerIcon" Source="{Binding SelectedAssemblerIcon}" Stretch="Uniform" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Name="SelectedAssemblerName" Text="{Binding SelectedAssemblerName}" Classes="foreman-picker-name" />
            <TextBlock Name="AssemblerStatsText" Text="{Binding AssemblerStats}" Classes="foreman-caption" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
        <insp:PickGrid Name="AssemblerGrid" Items="{Binding AssemblerOptions}" Margin="0,0,0,4" />
        <kit:FormGroup Theme="{StaticResource Kit.FormGroup}">
          <kit:FormRow Theme="{StaticResource Kit.FormRow}" Label="Neighbours" LabelColumn="Inspector"
                       IsVisible="{Binding ShowsNeighbours}">
            <ctrl:Stepper Name="AvgNeighboursValue" Theme="{StaticResource Kit.Stepper}" Minimum="0" Maximum="100" Increment="0.05" Decimals="2"
                          IsVisible="{Binding ShowsNeighbours}" Value="{Binding AvgNeighbours, Mode=TwoWay}" />
          </kit:FormRow>
          <kit:FormRow Theme="{StaticResource Kit.FormRow}" Label="Extra prod." LabelColumn="Inspector"
                       IsVisible="{Binding ShowsExtraProductivity}">
            <ctrl:Stepper Name="ExtraProductivityValue" Theme="{StaticResource Kit.Stepper}" Minimum="0" Maximum="100000" Increment="10" Decimals="2"
                          Unit="%" IsVisible="{Binding ShowsExtraProductivity}" Value="{Binding ExtraProductivityPercent, Mode=TwoWay}" />
          </kit:FormRow>
        </kit:FormGroup>
      </StackPanel>
    </kit:InspectorGroup>

    <Border Classes="foreman-inspector-group-rule" Height="1" Background="{DynamicResource Foreman.Color.Border}" />

    <kit:InspectorGroup Header="Fuel" IsVisible="{Binding ShowsFuel}" Theme="{StaticResource Kit.InspectorGroup}">
      <insp:PickGrid Name="FuelGrid" Items="{Binding FuelOptions}" />
    </kit:InspectorGroup>
    <Border Classes="foreman-inspector-group-rule" Height="1" IsVisible="{Binding ShowsFuel}"
            Background="{DynamicResource Foreman.Color.Border}" />

    <kit:InspectorGroup Name="ModulesGroup" Header="{Binding ModulesTitle}" IsVisible="{Binding HasModuleSlots}" Theme="{StaticResource Kit.InspectorGroup}">
      <kit:FormGroup Theme="{StaticResource Kit.FormGroup}">
        <kit:FormRow Theme="{StaticResource Kit.FormRow}" Label="Equipped" LabelColumn="Inspector"
                     Note="{Binding ModulesHelpText}">
          <kit:PickGrid Name="EquippedGrid" Theme="{StaticResource Kit.PickGrid}" GroupLabel="Module slots" EmptyItemNoun="module" />
        </kit:FormRow>
        <kit:FormRow Theme="{StaticResource Kit.FormRow}" Label="Add" LabelColumn="Inspector"
                     IsVisible="{Binding HasModuleOptions}">
          <kit:PickGrid Name="ModuleOptionsGrid" Theme="{StaticResource Kit.PickGrid}" GroupLabel="Available modules" NamesSlots="False" EmptyItemNoun="module" />
        </kit:FormRow>
      </kit:FormGroup>
    </kit:InspectorGroup>

    <Border Classes="foreman-inspector-group-rule" Height="1" IsVisible="{Binding HasModuleSlots}"
            Background="{DynamicResource Foreman.Color.Border}" />

    <kit:InspectorGroup Name="BeaconGroup" Header="Beacon" Theme="{StaticResource Kit.InspectorGroup}">
      <StackPanel Spacing="0">
        <StackPanel Orientation="Horizontal" Classes="foreman-picker-row">
          <Border Classes="foreman-picker-icon">
            <Image Name="SelectedBeaconIcon" Source="{Binding SelectedBeaconIcon}" Stretch="Uniform" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Name="BeaconNameText" Text="{Binding BeaconName}" Classes="foreman-picker-name" />
            <TextBlock Text="Tap to choose a beacon" Classes="foreman-caption" IsVisible="{Binding !HasBeacon}" />
          </StackPanel>
          <Button Name="ClearBeaconButton" Content="Clear" IsVisible="{Binding HasBeacon}" />
        </StackPanel>
        <insp:PickGrid Name="BeaconOptions" Items="{Binding BeaconOptions}" Margin="0,0,0,4" />

        <StackPanel Name="BeaconDetail" Spacing="{StaticResource Foreman.Space.Space2}" IsVisible="{Binding HasBeacon}">
          <kit:FormGroup Theme="{StaticResource Kit.FormGroup}">
            <kit:FormRow Theme="{StaticResource Kit.FormRow}" Label="Equipped" LabelColumn="Inspector">
              <kit:PickGrid Name="EquippedBeaconGrid" Theme="{StaticResource Kit.PickGrid}" GroupLabel="Beacon module slots" EmptyItemNoun="module" />
            </kit:FormRow>
            <kit:FormRow Theme="{StaticResource Kit.FormRow}" Label="Add" LabelColumn="Inspector"
                         IsVisible="{Binding HasBeaconModuleOptions}">
              <kit:PickGrid Name="BeaconModuleOptionsGrid" Theme="{StaticResource Kit.PickGrid}" GroupLabel="Available beacon modules" NamesSlots="False" EmptyItemNoun="module" />
            </kit:FormRow>
            <kit:FormRow Theme="{StaticResource Kit.FormRow}" Label="# Beacons" LabelColumn="Inspector">
              <ctrl:Stepper Name="BeaconCountValue" Theme="{StaticResource Kit.Stepper}" Minimum="0" Maximum="1000" Decimals="2"
                            Value="{Binding BeaconCount, Mode=TwoWay}" />
            </kit:FormRow>
            <kit:FormRow Theme="{StaticResource Kit.FormRow}" Label="/ Assembler" LabelColumn="Inspector">
              <ctrl:Stepper Name="BeaconsPerAssemblerValue" Theme="{StaticResource Kit.Stepper}" Minimum="0" Maximum="1000" Decimals="2"
                            Value="{Binding BeaconsPerAssembler, Mode=TwoWay}" />
            </kit:FormRow>
            <kit:FormRow Theme="{StaticResource Kit.FormRow}" Label="Additional" LabelColumn="Inspector">
              <ctrl:Stepper Name="BeaconsTotalValue" Theme="{StaticResource Kit.Stepper}" Minimum="0" Maximum="1000" Decimals="2"
                            Value="{Binding BeaconsTotal, Mode=TwoWay}" />
            </kit:FormRow>
          </kit:FormGroup>
        </StackPanel>
      </StackPanel>
    </kit:InspectorGroup>
  </StackPanel>
</UserControl>
