<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Foreman.Mac.Views.Inspector.CompactStepper">
  <Border Classes="foreman-stepper">
    <Grid ColumnDefinitions="Auto,Auto">
      <TextBox Grid.Column="0" Name="ValueBox" Classes="foreman-stepper-value" />
      <Border Grid.Column="1" Classes="foreman-stepper-arrows">
        <StackPanel Orientation="Vertical">
          <Button Name="IncrementButton" Classes="foreman-stepper-arrow foreman-stepper-arrow-top">
            <Path Classes="foreman-chevron" Data="{StaticResource Foreman.Icon.Chevron}" Width="7" Height="4">
              <Path.RenderTransform>
                <RotateTransform Angle="180" />
              </Path.RenderTransform>
            </Path>
          </Button>
          <Button Name="DecrementButton" Classes="foreman-stepper-arrow">
            <Path Classes="foreman-chevron" Data="{StaticResource Foreman.Icon.Chevron}" Width="7" Height="4" />
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
