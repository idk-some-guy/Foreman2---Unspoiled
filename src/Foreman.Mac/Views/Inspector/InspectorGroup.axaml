<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Foreman.Mac.Views.Inspector.InspectorGroup"
             x:Name="Root">
  <StackPanel Spacing="{StaticResource Foreman.Space.Space1}">
    <TextBlock Text="{Binding #Root.Title}" Classes="foreman-section-header" />
    <ContentPresenter Content="{Binding #Root.GroupContent}" IsVisible="{Binding #Root.IsExpanded}" />
  </StackPanel>
</UserControl>
