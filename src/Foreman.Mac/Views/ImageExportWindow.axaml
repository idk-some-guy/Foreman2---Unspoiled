<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Foreman.Mac.Views.ImageExportWindow"
        Title="Export an Image"
        Width="348"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="Manual"
        Background="{DynamicResource SystemChromeMediumColor}">
  <StackPanel Margin="12" Spacing="10">
    <Grid ColumnDefinitions="*,Auto">
      <TextBox Name="FileTextBox" Grid.Column="0" IsReadOnly="True" Margin="0,0,6,0" />
      <Button Name="BrowseButton" Grid.Column="1" Content="Browse..." />
    </Grid>
    <Border BorderBrush="Gray" BorderThickness="1" Padding="8">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <StackPanel Spacing="2">
          <TextBlock Text="Scale" FontWeight="Bold" />
          <ComboBox Name="ScaleSelectionBox" Width="80" />
        </StackPanel>
        <TextBlock Name="ImageSizeLabel" Text="Image Size: x x y" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
    <CheckBox Name="TransparencyCheckBox" Content="Transparent Background" />
    <CheckBox Name="ViewLimitCheckBox" Content="Limit to View" />
    <Button Name="ExportButton" Content="Export" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
  </StackPanel>
</Window>
