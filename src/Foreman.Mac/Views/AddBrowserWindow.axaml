<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Foreman.Mac.ViewModels"
        xmlns:ctrl="using:Foreman.Mac.Kit.Controls"
        xmlns:kit="using:Foreman.Mac.Kit.Composites"
        x:Class="Foreman.Mac.Views.AddBrowserWindow"
        x:DataType="vm:AddBrowserViewModel"
        Title="Add to Graph"
        Width="760" Height="520" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Foreman.Color.WindowBackground}">
  <DockPanel>
    <Border Name="ToolbarRow" DockPanel.Dock="Top" Padding="14,8"
            Background="{DynamicResource Foreman.Color.TitlebarBackground}"
            BorderBrush="{DynamicResource Foreman.Color.Border}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
        <ctrl:Segmented Grid.Column="0" Name="ModeSwitch" Theme="{StaticResource Kit.Segmented}" VerticalAlignment="Center" />
        <ctrl:SearchField Grid.Column="1" Name="SearchBox" Theme="{StaticResource Kit.SearchField}"
                          MaxWidth="260" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="{Binding SearchPlaceholder}" />
        <ctrl:Chip Grid.Column="2" Name="ConstraintChip" Theme="{StaticResource Kit.Chip}" VerticalAlignment="Center"
                   MaxWidth="260" Label="{Binding ChipText}" IsVisible="{Binding HasChip}" RemoveAccessibleName="Remove Constraint" />
        <ctrl:PopUp Grid.Column="3" Name="QualityPopUp" Theme="{StaticResource Kit.PopUp}" VerticalAlignment="Center"
                    Label="{Binding QualityLabel}" IsVisible="{Binding ShowsQuality}" />
        <ctrl:MenuButton Grid.Column="4" Name="FilterButton" Theme="{StaticResource Kit.MenuButton}" VerticalAlignment="Center"
                         Label="Filter" Glyph="{StaticResource Kit.Glyph.Filter.14}" />
      </Grid>
    </Border>

    <Border Name="Sidebar" DockPanel.Dock="Left" Width="{DynamicResource Foreman.Size.BrowserSidebar}" Padding="0,8"
            Background="{DynamicResource Foreman.Color.SidebarBackground}"
            BorderBrush="{DynamicResource Foreman.Color.Border}" BorderThickness="0,0,1,0">
      <ScrollViewer>
        <ItemsControl Name="GroupsList" ItemsSource="{Binding Groups}" KeyboardNavigation.TabNavigation="Once">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:BrowserGroup">
              <ctrl:SidebarRow Theme="{StaticResource Kit.SidebarRow}" Label="{Binding Name}" Icon="{Binding Icon}"
                               IsSelected="{Binding IsSelected}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <Grid RowDefinitions="*,Auto">
      <kit:ChooserGrid Grid.Row="0" Name="Grid" Theme="{StaticResource Kit.ChooserGrid}" />
      <Border Grid.Row="1" Name="Footer" Padding="16,8"
              BorderBrush="{DynamicResource Foreman.Color.Border}" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
          <TextBlock Grid.Column="0" Name="AddAsLabel" Theme="{StaticResource Kit.Text}" Classes="callout secondary"
                     Text="Add as" VerticalAlignment="Center" IsVisible="{Binding RolesVisible}" />
          <ctrl:PopUp Grid.Column="1" Name="RolePopUp" Theme="{StaticResource Kit.PopUp}" VerticalAlignment="Center"
                      AutomationProperties.Name="Add as" IsVisible="{Binding RolesVisible}" />
          <TextBlock Grid.Column="2" Name="SelectionCaption" Theme="{StaticResource Kit.Text}" Classes="caption tertiary"
                     Text="{Binding SelectionCaption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <kit:ButtonRow Grid.Column="3" Name="FooterButtons" Theme="{StaticResource Kit.ButtonRow}" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
