<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Foreman.Mac.ViewModels"
             xmlns:kit="using:Foreman.Mac.Kit.Composites"
             xmlns:ctrl="using:Foreman.Mac.Kit.Controls"
             x:Class="Foreman.Mac.Views.Settings.AnnotationsTab"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" AllowAutoHide="True">
    <StackPanel Margin="20,18,20,20">
      <kit:FormGroup Theme="{StaticResource Kit.FormGroup}" IsBoxed="True" Title="Guide arrows" TrailingGap="0">
        <kit:FormRow Theme="{StaticResource Kit.FormRow}" LabelColumn="Window" Label="Error arrows"
                     Note="Points an arrow from the edge of the view at any node with an error.">
          <ctrl:Switch Name="ErrorArrowsSwitch" Theme="{StaticResource Kit.Switch}"
                       IsChecked="{Binding ErrorArrowsChecked, Mode=TwoWay}" />
        </kit:FormRow>
        <kit:FormRow Theme="{StaticResource Kit.FormRow}" LabelColumn="Window" Label="Warning arrows"
                     Note="Points an arrow from the edge of the view at any node with a warning.">
          <ctrl:Switch Name="WarningArrowsSwitch" Theme="{StaticResource Kit.Switch}"
                       IsChecked="{Binding WarningArrowsChecked, Mode=TwoWay}" />
        </kit:FormRow>
        <kit:FormRow Theme="{StaticResource Kit.FormRow}" LabelColumn="Window" Label="Missing links"
                     Note="Points an arrow at any node with an input or output that is not connected.">
          <ctrl:Switch Name="DisconnectedArrowsSwitch" Theme="{StaticResource Kit.Switch}"
                       IsChecked="{Binding DisconnectedArrowsChecked, Mode=TwoWay}" />
        </kit:FormRow>
        <kit:FormRow Theme="{StaticResource Kit.FormRow}" LabelColumn="Window" Label="Supply arrows"
                     Note="Points an arrow at any node that is over-producing or under-supplied.">
          <ctrl:Switch Name="OUSuppliedArrowsSwitch" Theme="{StaticResource Kit.Switch}"
                       IsChecked="{Binding OuSuppliedArrowsChecked, Mode=TwoWay}" />
        </kit:FormRow>
        <kit:FormRow Theme="{StaticResource Kit.FormRow}" LabelColumn="Window" Label="Flag supply problems"
                     Note="Marks over-producing and under-supplied nodes on the node itself, not only with an arrow.">
          <ctrl:Switch Name="FlagOUSupplyNodesSwitch" Theme="{StaticResource Kit.Switch}"
                       IsChecked="{Binding FlagOUSupplyNodesChecked, Mode=TwoWay}" />
        </kit:FormRow>
      </kit:FormGroup>
    </StackPanel>
  </ScrollViewer>
</UserControl>
