<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Foreman.Mac.Views.SciencePacksWindow"
        Title="Select researched science packs"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        Background="{DynamicResource SystemChromeMediumColor}">
  <StackPanel Margin="12" Spacing="12">
    <UniformGrid Name="SciencePackGrid" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
      <Button Name="ConfirmationButton" Content="Confirm" IsDefault="True" />
      <Button Name="CancellationButton" Content="Cancel" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
