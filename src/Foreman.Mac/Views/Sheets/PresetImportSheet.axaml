<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kit="using:Foreman.Mac.Kit.Composites"
             xmlns:ctrl="using:Foreman.Mac.Kit.Controls"
             x:Class="Foreman.Mac.Views.Sheets.PresetImportSheet">
  <kit:FormGroup Theme="{StaticResource Kit.FormGroup}">
    <kit:FormRow Name="FactorioLocationRow" Theme="{StaticResource Kit.FormRow}" Label="Factorio install" LabelColumn="Window"
                 Note="Language, mods, and mod settings come from Factorio. Change them there before importing.">
      <StackPanel Spacing="{DynamicResource Foreman.Space.Space1}">
        <ctrl:PopUp Name="FactorioLocationComboBox" Theme="{StaticResource Kit.PopUp}" IsVisible="False" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Foreman.Space.Space2}">
          <TextBox Name="FactorioLocationTextBox" Grid.Column="0" Theme="{StaticResource Kit.TextField}" />
          <Button Name="FactorioBrowseButton" Grid.Column="1" Theme="{StaticResource Kit.Button}" Content="Browse…" />
        </Grid>
      </StackPanel>
    </kit:FormRow>
    <kit:FormRow Name="PresetNameRow" Theme="{StaticResource Kit.FormRow}" Label="Preset name" LabelColumn="Window"
                 Note="5–40 characters: letters, numbers, spaces, and ( ) . - _">
      <TextBox Name="PresetNameTextBox" Theme="{StaticResource Kit.TextField}" Text="Factorio 2.0 Space Age" MaxLength="40" />
    </kit:FormRow>
    <kit:FormRow Name="ModsLocationRow" Theme="{StaticResource Kit.FormRow}" Label="Mods folder" LabelColumn="Window"
                 Note="Leave blank to detect it automatically.">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Foreman.Space.Space2}">
        <TextBox Name="ModsLocationTextBox" Grid.Column="0" Theme="{StaticResource Kit.TextField}" />
        <Button Name="ModsBrowseButton" Grid.Column="1" Theme="{StaticResource Kit.Button}" Content="Browse…" />
      </Grid>
    </kit:FormRow>
  </kit:FormGroup>
</UserControl>
