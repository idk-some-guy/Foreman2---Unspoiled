<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kit="using:Foreman.Mac.Kit.Composites"
             xmlns:ctrl="using:Foreman.Mac.Kit.Controls"
             x:Class="Foreman.Mac.Views.Sheets.ShapePropertiesSheet">
  <kit:FormGroup Theme="{StaticResource Kit.FormGroup}" TrailingGap="0">
    <kit:FormRow Theme="{StaticResource Kit.FormRow}" Label="Shape" LabelColumn="Window">
      <ctrl:Segmented Name="ShapeSegments" Theme="{StaticResource Kit.Segmented}" />
    </kit:FormRow>
    <kit:FormRow Theme="{StaticResource Kit.FormRow}" Label="Fill" LabelColumn="Window">
      <ctrl:ColorWell Name="FillWell" Theme="{StaticResource Kit.ColorWell}" AllowsNone="True" AllowsAlpha="True" />
    </kit:FormRow>
    <kit:FormRow Theme="{StaticResource Kit.FormRow}" Label="Opacity" LabelColumn="Window">
      <ctrl:Slider Name="OpacitySlider" Theme="{StaticResource Kit.Slider}"
                   Minimum="0" Maximum="100" Step="1" PageStep="10" ShowValue="True" Unit="%"
                   Width="NaN" HorizontalAlignment="Stretch" />
    </kit:FormRow>
    <kit:FormRow Theme="{StaticResource Kit.FormRow}" Label="Border" LabelColumn="Window">
      <ctrl:ColorWell Name="BorderWell" Theme="{StaticResource Kit.ColorWell}" />
    </kit:FormRow>
    <kit:FormRow Theme="{StaticResource Kit.FormRow}" Label="Border width" LabelColumn="Window">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Foreman.Space.Space1}">
        <ctrl:Stepper Name="BorderWidthStepper" Theme="{StaticResource Kit.Stepper}"
                      Minimum="0" Maximum="50" Increment="1" Decimals="0" SpokenUnit="pixels"
                      AutomationProperties.Name="Border width" />
        <TextBlock Theme="{StaticResource Kit.Text}" Classes="callout secondary" Text="px" VerticalAlignment="Center" />
      </StackPanel>
    </kit:FormRow>
  </kit:FormGroup>
</UserControl>
