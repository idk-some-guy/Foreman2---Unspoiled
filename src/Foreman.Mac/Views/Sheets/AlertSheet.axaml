<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kit="using:Foreman.Mac.Kit.Composites"
             x:Class="Foreman.Mac.Views.Sheets.AlertSheet">
  <kit:AlertFrame Name="Frame" Theme="{StaticResource Kit.AlertFrame}">
    <kit:AlertFrame.Buttons>
      <kit:ButtonRow Name="Row" Theme="{StaticResource Kit.ButtonRow}" />
    </kit:AlertFrame.Buttons>
  </kit:AlertFrame>
</UserControl>
