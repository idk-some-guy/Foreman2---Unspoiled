<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Foreman.Mac.Views.Sheets.AlertSheet">
  <StackPanel Spacing="16">
    <TextBlock Name="TitleTextBlock" FontWeight="Bold" TextWrapping="Wrap" />
    <TextBlock Name="MessageTextBlock" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Name="CancelButton" Content="Cancel" />
      <Button Name="NoButton" Content="No" />
      <Button Name="YesButton" Content="Yes" />
    </StackPanel>
  </StackPanel>
</UserControl>
