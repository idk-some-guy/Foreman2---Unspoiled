<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Foreman.Mac.Views.Sheets.ResearchSyncSheet">
  <StackPanel>
    <TextBlock Name="LedeBlock" Theme="{StaticResource Kit.Text}" Classes="callout secondary" TextWrapping="Wrap" />
    <StackPanel Name="ChangeList" Margin="0,14,0,0" IsVisible="False" />
    <TextBlock Name="MoreBlock" Theme="{StaticResource Kit.Text}" Classes="caption secondary" Margin="0,4,0,0" IsVisible="False" />
    <Border Name="MismatchBlock" Margin="0,12,0,0" Background="{DynamicResource Foreman.Color.WarningSoft}"
            CornerRadius="{DynamicResource Foreman.Radius.Control}" Padding="6,8" IsVisible="False">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Foreman.Space.Space2}">
        <Viewbox Grid.Column="0" Width="{DynamicResource Foreman.Size.Glyph16}" Height="{DynamicResource Foreman.Size.Glyph16}"
                 Stretch="Uniform" VerticalAlignment="Top">
          <Path Theme="{StaticResource Kit.Glyph}" Data="{StaticResource Kit.Glyph.Alert.16}"
                Stroke="{DynamicResource Foreman.Color.Warning}" Width="16" Height="16" Stretch="None" />
        </Viewbox>
        <TextBlock Name="MismatchSentenceBlock" Grid.Column="1" Theme="{StaticResource Kit.Text}" Classes="callout" TextWrapping="Wrap" />
      </Grid>
    </Border>
    <TextBlock Name="MismatchLinesBlock" Theme="{StaticResource Kit.Text}" Classes="caption secondary" TextWrapping="Wrap"
               Margin="22,6,0,0" IsVisible="False" />
    <TextBlock Name="VersionNoteBlock" Theme="{StaticResource Kit.Text}" Classes="caption secondary" TextWrapping="Wrap"
               Margin="0,10,0,0" IsVisible="False" />
  </StackPanel>
</UserControl>
