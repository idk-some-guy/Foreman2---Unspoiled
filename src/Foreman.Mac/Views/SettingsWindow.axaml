<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Foreman.Mac.ViewModels"
        xmlns:kit="using:Foreman.Mac.Kit.Controls"
        x:Class="Foreman.Mac.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Presets"
        Width="520"
        Height="480"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Foreman.Color.WindowBackground}">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Foreman.Color.TitlebarBackground}"
            BorderBrush="{DynamicResource Foreman.Color.Border}" BorderThickness="0,0,0,1">
      <kit:TabStrip Name="PaneStrip" Theme="{StaticResource Kit.TabStrip}" Classes="toolbar-tabs" Margin="0,3"
                    AutomationProperties.Name="Settings panes" />
    </Border>

    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Foreman.Color.Border}" BorderThickness="0,1,0,0" Padding="16,8">
      <DockPanel Name="FooterRow" LastChildFill="False">
        <TextBlock Name="FooterText" DockPanel.Dock="Left" VerticalAlignment="Center"
                   Theme="{StaticResource Kit.Text}" Classes="caption tertiary" />
        <Button Name="RestoreDefaultsButton" DockPanel.Dock="Right" Theme="{StaticResource Kit.Button}" Content="Restore Defaults" />
      </DockPanel>
    </Border>

    <ContentControl Name="TabBody" />
  </DockPanel>
</Window>
