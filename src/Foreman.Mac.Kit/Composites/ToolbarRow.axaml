<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:kit="using:Foreman.Mac.Kit.Composites">

  <ControlTheme x:Key="Kit.ToolbarRow" TargetType="kit:ToolbarRow">
    <Setter Property="Height" Value="{DynamicResource Foreman.Size.ToolbarRowHeight}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.WindowBackground}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <kit:ToolbarRowPanel x:Name="PART_Panel" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
