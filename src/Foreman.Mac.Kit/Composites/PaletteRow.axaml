<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:kit="using:Foreman.Mac.Kit.Composites"
                    xmlns:m="using:Foreman.Mac.Kit">

  <ControlTheme x:Key="Kit.PaletteRow" TargetType="kit:PaletteRow">
    <Setter Property="Height" Value="{DynamicResource Foreman.Size.ListRowHeight}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Frame"
                Height="{DynamicResource Foreman.Size.ListRowHeight}"
                CornerRadius="{DynamicResource Foreman.Radius.Control}"
                Background="{TemplateBinding Background}">
          <Panel>
            <Border x:Name="PART_Fill"
                    CornerRadius="{DynamicResource Foreman.Radius.Control}"
                    Opacity="0"
                    IsHitTestVisible="False"
                    Transitions="{x:Static m:Motion.RowSelectionTransitions}" />
            <Border x:Name="PART_SelectionFill"
                    CornerRadius="{DynamicResource Foreman.Radius.Control}"
                    Opacity="0"
                    IsHitTestVisible="False"
                    Transitions="{x:Static m:Motion.RowSelectionTransitions}" />
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,0">
              <Border x:Name="PART_Icon"
                      Grid.Column="0"
                      Width="{DynamicResource Foreman.Size.PaletteRowIcon}"
                      Height="{DynamicResource Foreman.Size.PaletteRowIcon}"
                      CornerRadius="{DynamicResource Foreman.Radius.PaletteRowIcon}"
                      Background="{TemplateBinding Icon}"
                      BorderBrush="{DynamicResource Foreman.Color.BorderStrong}"
                      BorderThickness="1"
                      Margin="0,0,8,0" />
              <TextBlock x:Name="PART_Label"
                         Grid.Column="1"
                         Text="{TemplateBinding Label}"
                         FontSize="{DynamicResource Foreman.Type.Callout.FontSize}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="PART_Kind"
                         Grid.Column="2"
                         Text="{TemplateBinding Kind}"
                         FontSize="{DynamicResource Foreman.Type.Caption.FontSize}"
                         FontWeight="{DynamicResource Foreman.Type.Caption.FontWeight}"
                         TextTrimming="None"
                         Margin="8,0,0,0"
                         VerticalAlignment="Center" />
            </Grid>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{DynamicResource Foreman.Opacity.Disabled}" />
    </Style>
    <Style Selector="^.entering">
      <Setter Property="Opacity" Value="0" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
