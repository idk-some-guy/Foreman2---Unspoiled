<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:kit="using:Foreman.Mac.Kit.Composites"
                    xmlns:ctrl="using:Foreman.Mac.Kit.Controls">

  <ControlTheme x:Key="Kit.ZoomStepperMicroButton" TargetType="Button">
    <Setter Property="Width" Value="{DynamicResource Foreman.Size.ZoomStepperMicroButtonWidth}" />
    <Setter Property="Height" Value="{DynamicResource Foreman.Size.ZoomStepperMicroButtonHeight}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ctrl:FocusRing.IsEnabled" Value="True" />
    <Setter Property="ctrl:FocusRing.CornerRadius" Value="4" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover, ^.gallery-hover">
      <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackgroundHover}" />
    </Style>
    <Style Selector="^:pressed, ^.gallery-pressed">
      <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackgroundPressed}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="Kit.ZoomStepperReadout" TargetType="kit:ZoomStepperReadout">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ctrl:FocusRing.IsEnabled" Value="True" />
    <Setter Property="ctrl:FocusRing.CornerRadius" Value="4" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover, ^.gallery-hover">
      <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackgroundHover}" />
    </Style>
    <Style Selector="^:pressed, ^.gallery-pressed">
      <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackgroundPressed}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="Kit.ZoomStepper" TargetType="kit:ZoomStepper">
    <Setter Property="Height" Value="{DynamicResource Foreman.Size.ControlHeightRegular}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource Foreman.Color.ControlBackground}"
                BorderBrush="{DynamicResource Foreman.Color.Border}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Foreman.Radius.Control}"
                Padding="{DynamicResource Foreman.Thickness.Space05}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Foreman.Space.Space05}">
            <Button x:Name="PART_Minus"
                    Theme="{StaticResource Kit.ZoomStepperMicroButton}"
                    Command="{TemplateBinding ZoomOutCommand}"
                    ToolTip.Tip="Zoom Out"
                    AutomationProperties.Name="Zoom Out">
              <Viewbox Width="{DynamicResource Foreman.Size.GlyphMicro}" Height="{DynamicResource Foreman.Size.GlyphMicro}" Stretch="Uniform" StretchDirection="Both">
                <Path Theme="{StaticResource Kit.Glyph}"
                      Classes="fill"
                      Data="{StaticResource Kit.Glyph.Minus.12}"
                      Fill="{DynamicResource Foreman.Color.TextSecondary}"
                      Width="12" Height="12" Stretch="None" />
              </Viewbox>
            </Button>

            <kit:ZoomStepperReadout x:Name="PART_Readout"
                    Theme="{StaticResource Kit.ZoomStepperReadout}"
                    Width="{DynamicResource Foreman.Size.ZoomReadoutWidth}"
                    Height="{DynamicResource Foreman.Size.ZoomReadoutHeight}"
                    Focusable="True">
              <Grid>
                <TextBlock x:Name="PART_Value"
                           Theme="{StaticResource Kit.Text}"
                           Classes="caption secondary"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <Panel x:Name="PART_SolveStatusHost" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </kit:ZoomStepperReadout>

            <Button x:Name="PART_Plus"
                    Theme="{StaticResource Kit.ZoomStepperMicroButton}"
                    Command="{TemplateBinding ZoomInCommand}"
                    ToolTip.Tip="Zoom In"
                    AutomationProperties.Name="Zoom In">
              <Viewbox Width="{DynamicResource Foreman.Size.GlyphMicro}" Height="{DynamicResource Foreman.Size.GlyphMicro}" Stretch="Uniform" StretchDirection="Both">
                <Path Theme="{StaticResource Kit.Glyph}"
                      Classes="fill"
                      Data="{StaticResource Kit.Glyph.Plus.12}"
                      Fill="{DynamicResource Foreman.Color.TextSecondary}"
                      Width="12" Height="12" Stretch="None" />
              </Viewbox>
            </Button>
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
