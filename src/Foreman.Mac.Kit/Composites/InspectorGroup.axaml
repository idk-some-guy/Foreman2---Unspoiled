<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:kit="using:Foreman.Mac.Kit.Composites"
                    xmlns:ctrl="using:Foreman.Mac.Kit.Controls"
                    xmlns:m="using:Foreman.Mac.Kit">

  <ControlTheme x:Key="Kit.InspectorGroup" TargetType="kit:InspectorGroup">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel>
          <Border x:Name="PART_HeaderRow"
                  Height="{DynamicResource Foreman.Size.ControlHeightRegular}"
                  Padding="{DynamicResource Foreman.Thickness.InspectorGroupHeaderPadding}"
                  CornerRadius="{DynamicResource Foreman.Radius.InspectorGroupHeader}"
                  Background="Transparent"
                  Focusable="True"
                  Cursor="Hand"
                  ctrl:FocusRing.IsEnabled="True"
                  ctrl:FocusRing.CornerRadius="{DynamicResource Foreman.Radius.InspectorGroupHeader}">
            <StackPanel Orientation="Horizontal"
                        Spacing="{DynamicResource Foreman.Size.ControlGlyphGap}"
                        VerticalAlignment="Center">
              <Viewbox Width="{DynamicResource Foreman.Size.GlyphMicro}"
                       Height="{DynamicResource Foreman.Size.GlyphMicro}"
                       Stretch="Uniform"
                       StretchDirection="Both"
                       VerticalAlignment="Center">
                <Path x:Name="PART_Triangle"
                      Data="{StaticResource Kit.Glyph.Disclosure.12}"
                      Stretch="None"
                      Width="12" Height="12"
                      Fill="{DynamicResource Foreman.Color.TextSecondary}"
                      RenderTransformOrigin="50%,50%"
                      Transitions="{x:Static m:Motion.DisclosureTransitions}" />
              </Viewbox>
              <ContentPresenter x:Name="PART_HeaderText"
                                 Content="{TemplateBinding Header}"
                                 FontSize="{DynamicResource Foreman.Type.SectionHeader.FontSize}"
                                 FontWeight="{DynamicResource Foreman.Type.SectionHeader.FontWeight}"
                                 LetterSpacing="0"
                                 Foreground="{DynamicResource Foreman.Color.TextSecondary}"
                                 VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <ContentPresenter x:Name="PART_ContentHost" IsVisible="False" />
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ Border#PART_HeaderRow:pointerover, ^.gallery-hover /template/ Border#PART_HeaderRow">
      <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackgroundHover}" />
    </Style>
    <Style Selector="^ /template/ Border#PART_HeaderRow:pointerover ContentPresenter#PART_HeaderText, ^.gallery-hover /template/ ContentPresenter#PART_HeaderText">
      <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.Text}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{DynamicResource Foreman.Opacity.Disabled}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
