<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:kit="using:Foreman.Mac.Kit.Composites"
                    xmlns:ctrl="using:Foreman.Mac.Kit.Controls">

  <ControlTheme x:Key="Kit.ChooserCell" TargetType="kit:ChooserCell">
    <Setter Property="Width" Value="{DynamicResource Foreman.Size.ChooserCell}" />
    <Setter Property="Height" Value="{DynamicResource Foreman.Size.ChooserCell}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="ctrl:FocusRing.CornerRadius" Value="{DynamicResource Foreman.Radius.ChooserCell}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Frame"
                Background="{TemplateBinding Background}"
                CornerRadius="{DynamicResource Foreman.Radius.ChooserCell}">
          <StackPanel Margin="{TemplateBinding Padding}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="6">
            <Border x:Name="PART_IconFrame"
                    Width="{DynamicResource Foreman.Size.BrowserCell}"
                    Height="{DynamicResource Foreman.Size.BrowserCell}"
                    CornerRadius="{DynamicResource Foreman.Radius.ChooserCell}"
                    BorderBrush="{DynamicResource Foreman.Color.BorderStrong}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    HorizontalAlignment="Center">
              <Image x:Name="PART_Icon" Stretch="Uniform" Source="{TemplateBinding Icon}" />
            </Border>
            <TextBlock x:Name="PART_Label"
                       Theme="{StaticResource Kit.Text}"
                       Classes="caption secondary"
                       Text="{TemplateBinding Label}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="2"
                       LineHeight="{DynamicResource Foreman.Type.Caption.LineHeight}"
                       Height="{DynamicResource Foreman.Size.BrowserCellLabelHeight}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover:not(:selected), ^.gallery-hover:not(:selected)">
      <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackgroundHover}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource Foreman.Color.AccentSoft}" />
    </Style>
    <Style Selector="^[(ctrl|ListHost.IsKey)=False]:selected">
      <Setter Property="Background" Value="{DynamicResource Foreman.Color.SelectionInactive}" />
    </Style>
    <Style Selector="^:selected /template/ TextBlock#PART_Label">
      <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.AccentText}" />
      <Setter Property="FontWeight" Value="{DynamicResource Foreman.Type.Caption.Emphasized.FontWeight}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{DynamicResource Foreman.Opacity.Disabled}" />
    </Style>
    <Style Selector="^.entering">
      <Setter Property="Opacity" Value="0" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
