<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:kit="using:Foreman.Mac.Kit.Composites"
                    xmlns:ctrl="using:Foreman.Mac.Kit.Controls">

  <ControlTheme x:Key="Kit.SolveStatusTriangle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="Kit.SolveStatus" TargetType="kit:SolveStatus">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel x:Name="PART_Slot"
               Width="{DynamicResource Foreman.Size.Glyph16}"
               Height="{DynamicResource Foreman.Size.Glyph16}"
               IsVisible="False">
          <ctrl:Spinner x:Name="PART_Spinner" Theme="{StaticResource Kit.Spinner}" Classes="sm"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsVisible="False"
                        AutomationProperties.ControlTypeOverride="ProgressBar"
                        AutomationProperties.Name="Solving graph" />
          <Button x:Name="PART_Triangle" Theme="{StaticResource Kit.SolveStatusTriangle}" IsVisible="False"
                  AutomationProperties.Name="Solve failed"
                  AutomationProperties.HelpText="Shows why the graph couldn't be solved.">
            <Viewbox x:Name="PART_GlyphViewbox"
                     Width="{DynamicResource Foreman.Size.Glyph16}"
                     Height="{DynamicResource Foreman.Size.Glyph16}"
                     Stretch="Uniform" StretchDirection="Both">
              <Path x:Name="PART_Glyph"
                    Theme="{StaticResource Kit.Glyph}"
                    Data="{StaticResource Kit.Glyph.Alert.16}"
                    Stroke="{DynamicResource Foreman.Color.Warning}"
                    Width="16" Height="16" Stretch="None" />
            </Viewbox>
          </Button>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
