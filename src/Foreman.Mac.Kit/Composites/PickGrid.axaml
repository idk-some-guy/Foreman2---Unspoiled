<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:kit="using:Foreman.Mac.Kit.Composites">

  <ControlTheme x:Key="Kit.PickGrid" TargetType="kit:PickGrid">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Grid x:Name="PART_Grid" />
          <WrapPanel x:Name="PART_Wrap" Orientation="Horizontal" IsVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
