<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Generated from tools/Kit/alias-map.csv (kept in sync by AliasTests.AliasMapCsv_MatchesAliasesAxamlKeySet); each variant merges its own Tokens file so StaticResource resolves eagerly, in-file. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Foreman.Mac.Kit/Themes/Tokens.Light.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <StaticResource x:Key="Foreman.Color.Selection" ResourceKey="Foreman.Color.NodeSelected" />
