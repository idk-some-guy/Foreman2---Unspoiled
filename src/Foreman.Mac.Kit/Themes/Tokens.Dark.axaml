<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="Foreman.Color.CanvasBackground">#1E1E20</Color>
  <Color x:Key="Foreman.Color.WindowBackground">#29292B</Color>
  <Color x:Key="Foreman.Color.TitlebarBackground">#323234</Color>
  <Color x:Key="Foreman.Color.SidebarBackground">#2C2C2E</Color>
  <Color x:Key="Foreman.Color.InspectorBackground">#2C2C2E</Color>
  <Color x:Key="Foreman.Color.ControlBackground">#3D3D40</Color>
  <Color x:Key="Foreman.Color.ControlBackgroundHover">#48484C</Color>
  <Color x:Key="Foreman.Color.WellBackground">#232325</Color>
  <Color x:Key="Foreman.Color.Border">#17FFFFFF</Color>
  <Color x:Key="Foreman.Color.BorderStrong">#29FFFFFF</Color>
  <Color x:Key="Foreman.Color.Text">#EBFFFFFF</Color>
  <Color x:Key="Foreman.Color.TextSecondary">#8CFFFFFF</Color>
  <Color x:Key="Foreman.Color.TextTertiary">#52FFFFFF</Color>
  <Color x:Key="Foreman.Color.Accent">#0A84FF</Color>
  <Color x:Key="Foreman.Color.AccentSoft">#290A84FF</Color>
  <Color x:Key="Foreman.Color.AccentText">#6bb2ff</Color>
  <!-- Accent/Error at the button table's +8%/-12% brightness states (kit §01). -->
  <Color x:Key="Foreman.Color.AccentHover">#0B8FFF</Color>
  <Color x:Key="Foreman.Color.AccentPressed">#0974E0</Color>
  <Color x:Key="Foreman.Color.NodeSelected">#FF9F0A</Color>
  <Color x:Key="Foreman.Color.Error">#FF453A</Color>
  <Color x:Key="Foreman.Color.ErrorHover">#FF4B3F</Color>
  <Color x:Key="Foreman.Color.ErrorPressed">#E03D33</Color>
  <Color x:Key="Foreman.Color.Warning">#FF9F0A</Color>
  <Color x:Key="Foreman.Color.Success">#30D158</Color>
  <Color x:Key="Foreman.Color.ErrorSoft">#3DFF453A</Color>
  <Color x:Key="Foreman.Color.WarningSoft">#38FF9F0A</Color>
  <Color x:Key="Foreman.Color.SuccessSoft">#7330D158</Color>
  <Color x:Key="Foreman.Color.FocusRing">#0A84FF</Color>
  <x:Double x:Key="Foreman.FocusRing.Width">3</x:Double>
  <x:Double x:Key="Foreman.FocusRing.Offset">2</x:Double>
  <Color x:Key="Foreman.Color.SelectionInactive">#21FFFFFF</Color>
  <Color x:Key="Foreman.Color.ControlBackgroundPressed">#3F3F43</Color>
  <Color x:Key="Foreman.Color.TextOnAccent">#FFFFFF</Color>

  <!-- PopoverMaterial and TitlebarMaterialOpaque have no contract hex; they reuse ControlBackground / TitlebarBackground -->
  <Color x:Key="Foreman.Color.PopoverMaterial">#3D3D40</Color>
  <Color x:Key="Foreman.Color.TitlebarMaterialOpaque">#323234</Color>

  <x:Double x:Key="Foreman.Opacity.Disabled">0.38</x:Double>

  <!-- PickCellSelected mirrors AccentSoft's value rather than referencing it, kept independent on purpose. -->
  <Color x:Key="Foreman.Color.PickCellSelected">#290A84FF</Color>
  <Color x:Key="Foreman.Color.PickCellBorder">#29FFFFFF</Color>

  <!-- Status tokens: existing availability/similarity row coloring (GraphSummary, Enabled Objects), not part of the phase 9 visual-language contract. -->
  <Color x:Key="Foreman.Color.StatusForeground">#F2F2F2</Color>
  <Color x:Key="Foreman.Color.StatusWarningForeground">#FF8A80</Color>
  <Color x:Key="Foreman.Color.StatusWarningBackground">#4A2B30</Color>
  <Color x:Key="Foreman.Color.StatusCautionBackground">#453D22</Color>

  <x:Double x:Key="Foreman.Space.Space1">4</x:Double>
  <x:Double x:Key="Foreman.Space.Space2">8</x:Double>
  <x:Double x:Key="Foreman.Space.Space3">12</x:Double>
  <x:Double x:Key="Foreman.Space.Space4">16</x:Double>
  <x:Double x:Key="Foreman.Space.Space5">24</x:Double>
  <x:Double x:Key="Foreman.Space.Space6">32</x:Double>

  <!-- Thickness twins of Space.Space1-6: CornerRadius and Thickness (Margin/Padding) reject a boxed x:Double resource at style-application time. -->
  <Thickness x:Key="Foreman.Thickness.Space1">4</Thickness>
  <Thickness x:Key="Foreman.Thickness.Space2">8</Thickness>
  <Thickness x:Key="Foreman.Thickness.Space3">12</Thickness>
  <Thickness x:Key="Foreman.Thickness.Space4">16</Thickness>
  <Thickness x:Key="Foreman.Thickness.Space5">24</Thickness>
  <Thickness x:Key="Foreman.Thickness.Space6">32</Thickness>
  <CornerRadius x:Key="Foreman.Radius.Control">6</CornerRadius>
  <CornerRadius x:Key="Foreman.Radius.Card">9</CornerRadius>
  <CornerRadius x:Key="Foreman.Radius.Window">11</CornerRadius>
  <!-- Distinct from Radius.Control's 6, per the addendum's group-header spec row. -->
  <CornerRadius x:Key="Foreman.Radius.InspectorGroupHeader">4</CornerRadius>
  <Thickness x:Key="Foreman.Thickness.InspectorGroupHeaderPadding">4,0,0,0</Thickness>

  <!-- The 5px gap is a per-cell margin (half of it, 2.5, on each side), not a panel Spacing. -->
  <CornerRadius x:Key="Foreman.Radius.PickCell">5</CornerRadius>
  <Thickness x:Key="Foreman.Thickness.PickCellGap">2.5</Thickness>

  <x:Double x:Key="Foreman.Type.LargeTitle.FontSize">20</x:Double>
  <FontWeight x:Key="Foreman.Type.LargeTitle.FontWeight">700</FontWeight>
  <x:Double x:Key="Foreman.Type.SectionHeader.FontSize">11</x:Double>
  <FontWeight x:Key="Foreman.Type.SectionHeader.FontWeight">600</FontWeight>
  <x:Double x:Key="Foreman.Type.SectionHeader.LetterSpacing">0.33</x:Double>
  <x:Double x:Key="Foreman.Type.Body.FontSize">13</x:Double>
  <FontWeight x:Key="Foreman.Type.Body.FontWeight">400</FontWeight>
  <x:Double x:Key="Foreman.Type.EmphasizedBody.FontSize">13</x:Double>
  <FontWeight x:Key="Foreman.Type.EmphasizedBody.FontWeight">600</FontWeight>
  <x:Double x:Key="Foreman.Type.Callout.FontSize">12</x:Double>
  <FontWeight x:Key="Foreman.Type.Callout.FontWeight">400</FontWeight>
  <FontWeight x:Key="Foreman.Type.Callout.Emphasized.FontWeight">500</FontWeight>
  <x:Double x:Key="Foreman.Type.Caption.FontSize">11</x:Double>
  <FontWeight x:Key="Foreman.Type.Caption.FontWeight">400</FontWeight>

  <!-- Per-surface sizes with no ramp-step match; K4 deletes each as its surface migrates onto the ramp. -->
  <x:Double x:Key="Foreman.Type.Legacy.About.Name.FontSize">15</x:Double>
  <x:Double x:Key="Foreman.Type.Legacy.About.Tagline.FontSize">10.5</x:Double>
  <x:Double x:Key="Foreman.Type.Legacy.About.Version.FontSize">11.5</x:Double>
  <x:Double x:Key="Foreman.Type.Legacy.Browser.Label.FontSize">10</x:Double>
  <x:Double x:Key="Foreman.Type.Legacy.Browser.Row.FontSize">12.5</x:Double>
  <x:Double x:Key="Foreman.Type.Legacy.Kbd.FontSize">9.5</x:Double>
  <x:Double x:Key="Foreman.Type.Legacy.Palette.Hint.FontSize">10</x:Double>
  <x:Double x:Key="Foreman.Type.Legacy.Palette.Row.FontSize">12.5</x:Double>
  <x:Double x:Key="Foreman.Type.Legacy.Palette.Sub.FontSize">10.5</x:Double>
  <x:Double x:Key="Foreman.Type.Legacy.SearchField.FontSize">12.5</x:Double>
  <x:Double x:Key="Foreman.Type.Legacy.Toolbar.Label.FontSize">11.5</x:Double>
  <FontWeight x:Key="Foreman.Type.Legacy.Toolbar.Label.FontWeight">500</FontWeight>
  <!-- Kit.ToolbarItem's icon+label caption; hig-critique ruling keeps it legacy at 9.5, not folded into the ramp. -->
  <x:Double x:Key="Foreman.Type.Legacy.ToolbarItem.Label.FontSize">9.5</x:Double>
  <FontWeight x:Key="Foreman.Type.Legacy.ToolbarItem.Label.FontWeight">500</FontWeight>

  <x:Double x:Key="Foreman.Size.InspectorWidth">300</x:Double>
  <x:Double x:Key="Foreman.Size.InspectorWidthMin">260</x:Double>
  <x:Double x:Key="Foreman.Size.InspectorWidthMax">380</x:Double>
  <!-- Split divider hit area; excluded from ScaleContract.MultipliedKeys on purpose - fixed at every scale step. -->
  <x:Double x:Key="Foreman.Size.SplitDividerHit">5</x:Double>
  <!-- Grip opacity at rest; AppearanceHub overrides this to 1 under Increase Contrast, same idiom as FocusRing.Width. -->
  <x:Double x:Key="Foreman.Opacity.SplitGripIdle">0</x:Double>
  <x:Double x:Key="Foreman.Size.ControlHeightRegular">22</x:Double>
  <x:Double x:Key="Foreman.Size.ControlHeightLarge">24</x:Double>
  <x:Double x:Key="Foreman.Size.PickCell">26</x:Double>
  <x:Double x:Key="Foreman.Size.FormLabelColumn">132</x:Double>
  <x:Double x:Key="Foreman.Size.FormLabelColumnInspector">108</x:Double>
  <x:Double x:Key="Foreman.Size.ToolbarItem">26</x:Double>
  <x:Double x:Key="Foreman.Size.ToolbarItemWidth">44</x:Double>
  <x:Double x:Key="Foreman.Size.ToolbarItemHeight">40</x:Double>
  <Thickness x:Key="Foreman.Thickness.ButtonPadding">13,0</Thickness>
  <Thickness x:Key="Foreman.Thickness.ToolbarItemPadding">8,3</Thickness>

  <!-- Checkbox/radio share one 15pt box; the radio uses Radius.Pill for a circular border. -->
  <x:Double x:Key="Foreman.Size.CheckBox">15</x:Double>
  <CornerRadius x:Key="Foreman.Radius.CheckBox">4</CornerRadius>
  <x:Double x:Key="Foreman.Size.RadioDot">7</x:Double>
  <x:Double x:Key="Foreman.Size.CheckGlyph">10</x:Double>
  <x:Double x:Key="Foreman.Size.CheckDashWidth">8</x:Double>
  <x:Double x:Key="Foreman.Size.CheckDashHeight">1.5</x:Double>
  <x:Double x:Key="Foreman.Size.SelectionLabelGap">7</x:Double>
  <x:Double x:Key="Foreman.Size.RadioGroupRowGap">6</x:Double>
  <x:Double x:Key="Foreman.Size.SwitchWidth">30</x:Double>
  <x:Double x:Key="Foreman.Size.SwitchHeight">18</x:Double>
  <x:Double x:Key="Foreman.Size.SwitchKnob">14</x:Double>
  <x:Double x:Key="Foreman.Size.SwitchKnobInset">2</x:Double>

  <!-- Segmented (kit mock §02): track radius reuses Radius.Control, item radius is its own step. -->
  <CornerRadius x:Key="Foreman.Radius.SegmentItem">4</CornerRadius>
  <Thickness x:Key="Foreman.Thickness.SegmentTrackPadding">2</Thickness>
  <Thickness x:Key="Foreman.Thickness.SegmentItemPadding">10,3</Thickness>
  <!-- .mini's drawn 11.5/500; the regular segment uses Type.Callout instead (task-5-context §mock). -->
  <x:Double x:Key="Foreman.Type.SegmentMini.FontSize">11.5</x:Double>
  <FontWeight x:Key="Foreman.Type.SegmentMini.FontWeight">500</FontWeight>

  <!-- Pop-up/pull-down/menu button (addendum §01-02): shared label-to-glyph gap. -->
  <x:Double x:Key="Foreman.Size.ControlGlyphGap">6</x:Double>
  <x:Double x:Key="Foreman.Size.PopUpIndicator">16</x:Double>
  <CornerRadius x:Key="Foreman.Radius.PopUpIndicator">3</CornerRadius>
  <Thickness x:Key="Foreman.Thickness.PopUpPadding">10,0,3,0</Thickness>
  <Thickness x:Key="Foreman.Thickness.PopUpPulldownPadding">10,0,8,0</Thickness>

  <!-- Menu panel/item (addendum §02, §08 ladder extension). -->
  <x:Double x:Key="Foreman.Size.GlyphMicro">12</x:Double>
  <x:Double x:Key="Foreman.Size.GlyphSmall">14</x:Double>
  <x:Double x:Key="Foreman.Size.MenuItemHeight">22</x:Double>
  <x:Double x:Key="Foreman.Size.MenuPanelMinWidth">208</x:Double>
  <x:Double x:Key="Foreman.Size.MenuCheckColumn">16</x:Double>
  <Thickness x:Key="Foreman.Thickness.MenuPanelPadding">0,4</Thickness>
  <Thickness x:Key="Foreman.Thickness.MenuItemMargin">4,0</Thickness>
  <Thickness x:Key="Foreman.Thickness.MenuItemPadding">6,0,12,0</Thickness>
  <Thickness x:Key="Foreman.Thickness.MenuSeparatorMargin">8,5</Thickness>
  <Thickness x:Key="Foreman.Thickness.MenuButtonPadding">8,0</Thickness>

  <!-- Shared 10pt chevron glyph (menu button, pop-up pull-down). -->
  <x:Double x:Key="Foreman.Size.Glyph10">10</x:Double>

  <!-- glyph drawn sizes; scaled by the scale contract; no consumer until K4 -->
  <x:Double x:Key="Foreman.Size.Glyph16">16</x:Double>
  <x:Double x:Key="Foreman.Size.Glyph17">17</x:Double>
  <x:Double x:Key="Foreman.Size.Glyph18">18</x:Double>
  <x:Double x:Key="Foreman.Size.Glyph20">20</x:Double>

  <!-- A minimal Skia-canvas bridge (KitSkia.TokenBridge) - no consumer yet, same as Foreman.Shadow.Window
       below, pending the fuller canvas migration dependency graph risk 6 flags. -->
  <x:Double x:Key="Foreman.Size.NodePadding">8</x:Double>
  <x:Double x:Key="Foreman.Type.Canvas.FontSize">10</x:Double>

  <!-- Overlay sidebar's soft left shadow and a pick cell's selected-ring, both BoxShadows so light/dark
       can each carry their own opacity. -->
  <BoxShadows x:Key="Foreman.Shadow.Sidebar">-2 0 10 0 #40000000</BoxShadows>
  <BoxShadows x:Key="Foreman.Shadow.PickSelectedRing">0 0 0 1 #0A84FF</BoxShadows>

  <x:Double x:Key="Foreman.Size.PaletteWidth">272</x:Double>
  <x:Double x:Key="Foreman.Size.PaletteRowIcon">22</x:Double>
  <BoxShadows x:Key="Foreman.Shadow.Popover">0 26 50 -14 #99000000</BoxShadows>

  <x:Double x:Key="Foreman.Size.BrowserSidebar">168</x:Double>
  <x:Double x:Key="Foreman.Size.BrowserSidebarMax">320</x:Double>
  <x:Double x:Key="Foreman.Size.BrowserCell">40</x:Double>
  <x:Double x:Key="Foreman.Size.ChooserCell">88</x:Double>
  <x:Double x:Key="Foreman.Size.BrowserCellRowHeight">78</x:Double>
  <x:Double x:Key="Foreman.Size.BrowserCellLabelHeight">24</x:Double>
  <CornerRadius x:Key="Foreman.Radius.SearchField">7</CornerRadius>
  <CornerRadius x:Key="Foreman.Radius.Pill">100</CornerRadius>

  <!-- Sheet overlay (C2c #modals): scrim alpha is identical in both themes, so it isn't a per-theme color. -->
  <Color x:Key="Foreman.Color.SheetScrim">#80000000</Color>
  <BoxShadows x:Key="Foreman.Shadow.Sheet">0 34 60 -12 #A6000000</BoxShadows>
  <CornerRadius x:Key="Foreman.Radius.SheetBottom">0,0,10,10</CornerRadius>
  <CornerRadius x:Key="Foreman.Radius.Node">10</CornerRadius>

  <!-- Window chrome shadow; no consumer yet. Alpha confirmed against Shadow.Popover's own (K3): same #3D/#99 pair in both themes. -->
  <BoxShadows x:Key="Foreman.Shadow.Window">0 30 60 -20 #99000000</BoxShadows>

  <!-- Canvas node card shadow; cards carry no shadow in dark, so Dark's alpha is zero. -->
  <BoxShadows x:Key="Foreman.Shadow.Card">0 2 8 0 #00000000</BoxShadows>

  <!-- GalleryWindow's QualityPicker chrome bubble mimics a floating panel's fixed dark chrome, which
       doesn't follow the app theme either. -->
  <Color x:Key="Foreman.Color.GalleryChrome">#000000</Color>

  <!-- TextField (addendum context, task 6): plain 22pt well field, min-width its own token. -->
  <x:Double x:Key="Foreman.Metrics.TextFieldMinWidth">84</x:Double>
  <Thickness x:Key="Foreman.Thickness.TextFieldPadding">8,0</Thickness>

  <!-- Search field (addendum §04): capsule bounds and its own glyph size off the 13pt step. -->
  <x:Double x:Key="Foreman.Metrics.SearchFieldMinWidth">120</x:Double>
  <x:Double x:Key="Foreman.Metrics.SearchFieldNaturalWidth">220</x:Double>
  <x:Double x:Key="Foreman.Size.SearchFieldGlyph">13</x:Double>
  <Thickness x:Key="Foreman.Thickness.SearchFieldGlyphMargin">8,0,6,0</Thickness>
  <Thickness x:Key="Foreman.Thickness.SearchFieldClearMargin">0,0,4,0</Thickness>

  <!-- Stepper (kit mock §01, task-6-context): 40pt field, 15pt arrow column; cell height is ControlHeightRegular / 2 at runtime, not its own token. -->
  <x:Double x:Key="Foreman.Size.StepperFieldWidth">40</x:Double>
  <x:Double x:Key="Foreman.Size.StepperArrowColumn">15</x:Double>

  <!-- Slider (addendum §03): thumb grows 14 -> 15 -> 16 across normal/hover/pressed. -->
  <x:Double x:Key="Foreman.Size.SliderTrack">3</x:Double>
  <x:Double x:Key="Foreman.Size.SliderThumbNormal">14</x:Double>
  <x:Double x:Key="Foreman.Size.SliderThumbHover">15</x:Double>
  <x:Double x:Key="Foreman.Size.SliderThumbPressed">16</x:Double>
  <x:Double x:Key="Foreman.Size.SliderTickHeight">4</x:Double>
  <x:Double x:Key="Foreman.Size.SliderTickGap">5</x:Double>
  <x:Double x:Key="Foreman.Size.SliderHeight">26</x:Double>
  <x:Double x:Key="Foreman.Metrics.SliderMinWidth">80</x:Double>
  <x:Double x:Key="Foreman.Metrics.SliderNaturalWidth">124</x:Double>
  <x:Double x:Key="Foreman.Metrics.SliderValueLabelWidth">36</x:Double>
  <Color x:Key="Foreman.Color.SliderThumb">#FFFFFF</Color>
  <!-- Hairline that separates a white thumb from a white well; light only, so dark carries zero alpha. -->
  <Color x:Key="Foreman.Color.SliderThumbBorder">#00FFFFFF</Color>
  <BoxShadows x:Key="Foreman.Shadow.SliderThumb">0 1 3 0 #66000000</BoxShadows>

  <!-- List/sidebar row (addendum §07): three selection states reuse existing color tokens; only bounds are new. -->
  <x:Double x:Key="Foreman.Size.ListRowHeight">26</x:Double>
  <x:Double x:Key="Foreman.Size.SidebarRowHeight">28</x:Double>
  <x:Double x:Key="Foreman.Size.ListRowIconGap">9</x:Double>
  <x:Double x:Key="Foreman.Size.SidebarRowIconGap">8</x:Double>
  <CornerRadius x:Key="Foreman.Radius.ListRowIcon">4</CornerRadius>
  <Thickness x:Key="Foreman.Thickness.ListRowPadding">10,0</Thickness>
  <Thickness x:Key="Foreman.Thickness.ListRowInset">6,0</Thickness>
  <Thickness x:Key="Foreman.Thickness.SidebarRowPadding">8,0</Thickness>
  <Thickness x:Key="Foreman.Thickness.SidebarRowInset">8,0</Thickness>
  <Thickness x:Key="Foreman.Thickness.ListFramePadding">6</Thickness>

  <!-- Group box (kit mock §04 form grammar): well-backed inset form row container. -->
  <x:Double x:Key="Foreman.Metrics.GroupBoxMaxWidth">420</x:Double>
  <Thickness x:Key="Foreman.Thickness.GroupBoxPadding">12,14</Thickness>
  <Thickness x:Key="Foreman.Thickness.GroupBoxTitleMargin">0,11,0,5</Thickness>

  <!-- Tab strip (addendum §05): .toolbar-tabs item bounds and its own label size step; .underline's own padding/radius. -->
  <x:Double x:Key="Foreman.Type.TabLabel.FontSize">10.5</x:Double>
  <FontWeight x:Key="Foreman.Type.TabLabel.FontWeight">500</FontWeight>
  <x:Double x:Key="Foreman.Metrics.TabItemMinWidth">64</x:Double>
  <x:Double x:Key="Foreman.Size.TabItemHeight">46</x:Double>
  <x:Double x:Key="Foreman.Size.TabItemGlyphGap">3</x:Double>
  <x:Double x:Key="Foreman.Size.TabItemGap">2</x:Double>
  <x:Double x:Key="Foreman.Size.UnderlineTabGap">18</x:Double>
  <Thickness x:Key="Foreman.Thickness.TabItemPadding">12,6</Thickness>
  <Thickness x:Key="Foreman.Thickness.TabStripPadding">6</Thickness>
  <Thickness x:Key="Foreman.Thickness.UnderlineTabPadding">2,0,2,8</Thickness>
  <CornerRadius x:Key="Foreman.Radius.UnderlineTabFocus">4</CornerRadius>

  <!-- Feedback set (addendum §06): tooltip, spinner, progress bar, chip, key cap. -->
  <Color x:Key="Foreman.Color.TooltipMaterial">#4A4A4A</Color>
  <Color x:Key="Foreman.Color.TooltipMaterialOpaque">#4A4A4A</Color>
  <Color x:Key="Foreman.Color.TooltipText">#FFFFFFFF</Color>
  <BoxShadows x:Key="Foreman.Shadow.Tooltip">0 4 12 -2 #4D000000</BoxShadows>
  <Thickness x:Key="Foreman.Thickness.TooltipPadding">8,4</Thickness>
  <x:Double x:Key="Foreman.Metrics.TooltipMaxWidth">260</x:Double>

  <x:Double x:Key="Foreman.Size.Spinner">18</x:Double>
  <x:Double x:Key="Foreman.Size.SpinnerLarge">24</x:Double>
  <x:Double x:Key="Foreman.Size.SpinnerStroke">2</x:Double>
  <x:Double x:Key="Foreman.Size.SpinnerStrokeLarge">2.5</x:Double>

  <x:Double x:Key="Foreman.Size.ProgressBarWidth">140</x:Double>
  <x:Double x:Key="Foreman.Size.ProgressBarHeight">6</x:Double>
  <x:Double x:Key="Foreman.Size.ProgressBarSegment">40</x:Double>

  <x:Double x:Key="Foreman.Size.ChipHeight">20</x:Double>
  <x:Double x:Key="Foreman.Size.ChipCloseBox">16</x:Double>
  <x:Double x:Key="Foreman.Size.ChipGap">4</x:Double>
  <Thickness x:Key="Foreman.Thickness.ChipPadding">10,0,4,0</Thickness>
  <Color x:Key="Foreman.Color.ChipCloseHover">#387F7F7F</Color>
  <x:Double x:Key="Foreman.Opacity.ChipCloseIdle">0.75</x:Double>

  <x:Double x:Key="Foreman.Size.KeyCapMinSquare">18</x:Double>
  <CornerRadius x:Key="Foreman.Radius.KeyCap">4</CornerRadius>
  <Thickness x:Key="Foreman.Thickness.KeyCapPadding">5,0</Thickness>
  <BoxShadows x:Key="Foreman.Shadow.KeyCapEdge">0 1 0 0 #29FFFFFF</BoxShadows>

</ResourceDictionary>
