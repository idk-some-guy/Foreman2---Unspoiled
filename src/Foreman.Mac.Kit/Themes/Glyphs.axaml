<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- one 20 pt master per glyph from the ratified sheet, scaled about the origin to 16/17/18 -->

  <!-- Stretch stays None; a scaling consumer wraps the Path in a Viewbox bound to Foreman.Size.GlyphNN. -->
  <ControlTheme x:Key="Kit.GlyphIcon" TargetType="Path">
    <Setter Property="Stretch" Value="None" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stroke" Value="{DynamicResource Foreman.Color.TextTertiary}" />
    <Style Selector="^.secondary">
      <Setter Property="Stroke" Value="{DynamicResource Foreman.Color.TextSecondary}" />
    </Style>
    <Style Selector="^.emphasis">
      <Setter Property="Stroke" Value="{DynamicResource Foreman.Color.Text}" />
    </Style>
    <Style Selector="^.fill">
      <Setter Property="Stroke" Value="{x:Null}" />
      <Setter Property="Fill" Value="{DynamicResource Foreman.Color.TextTertiary}" />
    </Style>
    <Style Selector="^.size16">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="^.size17">
      <Setter Property="Width" Value="17" />
      <Setter Property="Height" Value="17" />
    </Style>
    <Style Selector="^.size18">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="^.size20">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
    </Style>
  </ControlTheme>

