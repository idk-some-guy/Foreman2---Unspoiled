<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceInclude x:Key="Light" Source="avares://Foreman.Mac.Kit/Themes/Tokens.Light.axaml" />
    <ResourceInclude x:Key="Dark" Source="avares://Foreman.Mac.Kit/Themes/Tokens.Dark.axaml" />
  </ResourceDictionary.ThemeDictionaries>

  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://Foreman.Mac.Kit/Themes/Aliases.axaml" />
    <ResourceInclude Source="avares://Foreman.Mac.Kit/Themes/Glyphs.axaml" />
    <ResourceInclude Source="avares://Foreman.Mac.Kit/Controls/Text.axaml" />
    <ResourceInclude Source="avares://Foreman.Mac.Kit/Controls/Glyph.axaml" />
    <ResourceInclude Source="avares://Foreman.Mac.Kit/Controls/Button.axaml" />
    <ResourceInclude Source="avares://Foreman.Mac.Kit/Controls/ToolbarItem.axaml" />
    <ResourceInclude Source="avares://Foreman.Mac.Kit/Controls/CheckBox.axaml" />
    <ResourceInclude Source="avares://Foreman.Mac.Kit/Controls/RadioButton.axaml" />
    <ResourceInclude Source="avares://Foreman.Mac.Kit/Controls/RadioGroup.axaml" />
    <ResourceInclude Source="avares://Foreman.Mac.Kit/Controls/Switch.axaml" />
  </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
