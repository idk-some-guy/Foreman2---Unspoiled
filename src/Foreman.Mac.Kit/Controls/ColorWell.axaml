<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:kit="using:Foreman.Mac.Kit.Controls"
                    xmlns:m="using:Foreman.Mac.Kit">

  <ControlTheme x:Key="Kit.ColorWell" TargetType="kit:ColorWell">
    <Setter Property="Width" Value="{DynamicResource Foreman.Size.ColorWellWidth}" />
    <Setter Property="Height" Value="{DynamicResource Foreman.Size.ControlHeightRegular}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Foreman.Radius.Control}" />
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="kit:FocusRing.IsEnabled" Value="True" />
    <Setter Property="kit:FocusRing.CornerRadius" Value="{DynamicResource Foreman.Radius.Control}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="PART_Frame"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <Border x:Name="PART_StateFill"
                  Margin="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Opacity="0"
                  IsHitTestVisible="False"
                  Transitions="{x:Static m:Motion.RowSelectionTransitions}" />
          <DockPanel Margin="{TemplateBinding BorderThickness}">
            <Border x:Name="PART_ChevronColumn"
                    DockPanel.Dock="Right"
                    Width="{DynamicResource Foreman.Size.ColorWellChevronColumn}"
                    Background="Transparent">
              <Viewbox Width="{DynamicResource Foreman.Size.Glyph10}"
                       Height="{DynamicResource Foreman.Size.Glyph10}"
                       Stretch="Uniform"
                       StretchDirection="Both"
                       IsHitTestVisible="False">
                <Path x:Name="PART_Chevron"
                      Data="{StaticResource Kit.Glyph.Chevron.10}"
                      Fill="{DynamicResource Foreman.Color.TextSecondary}"
                      Stretch="None"
                      Width="10" Height="10" />
              </Viewbox>
            </Border>
            <Border x:Name="PART_Swatch"
                    CornerRadius="{DynamicResource Foreman.Radius.Swatch}"
                    ClipToBounds="True"
                    IsHitTestVisible="False">
              <Panel>
                <kit:SwatchChecker x:Name="PART_Checker" IsVisible="False" />
                <Border x:Name="PART_Fill" />
                <Border x:Name="PART_NoneFill"
                        Background="{DynamicResource Foreman.Color.WellBackground}"
                        IsVisible="False" />
                <Viewbox x:Name="PART_NoneBox"
                         Width="{DynamicResource Foreman.Size.GlyphMicro}"
                         Height="{DynamicResource Foreman.Size.GlyphMicro}"
                         Stretch="Uniform"
                         StretchDirection="Both"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsVisible="False">
                  <Path Theme="{StaticResource Kit.Glyph}"
                        Data="{StaticResource Kit.Glyph.NoneSlash.12}"
                        Stroke="{DynamicResource Foreman.Color.TextSecondary}"
                        Width="12" Height="12"
                        Stretch="None" />
                </Viewbox>
                <Border x:Name="PART_SwatchStroke"
                        BorderBrush="{DynamicResource Foreman.Color.SwatchStroke}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Foreman.Radius.Swatch}" />
              </Panel>
            </Border>
          </DockPanel>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#PART_StateFill, ^.gallery-hover /template/ Border#PART_StateFill">
      <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackgroundHover}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_StateFill, ^:open /template/ Border#PART_StateFill, ^.gallery-open /template/ Border#PART_StateFill">
      <Setter Property="Background" Value="{DynamicResource Foreman.Color.ControlBackgroundPressed}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{DynamicResource Foreman.Opacity.Disabled}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
