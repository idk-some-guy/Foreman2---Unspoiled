<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:kit="using:Foreman.Mac.Kit.Controls">

  <ControlTheme x:Key="Kit.MenuPanel" TargetType="kit:MenuPanel">
    <Setter Property="MinWidth" Value="{DynamicResource Foreman.Size.MenuPanelMinWidth}" />
    <Setter Property="Background" Value="{DynamicResource Foreman.Color.PopoverMaterial}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Foreman.Radius.Control}" />
    <Setter Property="Padding" Value="{DynamicResource Foreman.Thickness.MenuPanelPadding}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                BoxShadow="{DynamicResource Foreman.Shadow.Card}">
          <StackPanel x:Name="PART_Items" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
