<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://Foreman.Mac.Kit/Themes/Glyphs.axaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- The opt-in kit key for the K1 Kit.GlyphIcon rules (stroke, size classes) - same theme, new name. -->
  <ControlTheme x:Key="Kit.Glyph" TargetType="Path" BasedOn="{StaticResource Kit.GlyphIcon}" />

</ResourceDictionary>
