<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://Foreman.Mac.Kit/Themes/Glyphs.axaml" />
  </ResourceDictionary.MergedDictionaries>

  <ControlTheme x:Key="Kit.Glyph" TargetType="Path" BasedOn="{StaticResource Kit.GlyphIcon}" />

</ResourceDictionary>
