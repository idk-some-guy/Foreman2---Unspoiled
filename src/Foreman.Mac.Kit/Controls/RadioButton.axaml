<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:kit="using:Foreman.Mac.Kit.Controls"
                    xmlns:conv="using:Avalonia.Data.Converters">

  <ControlTheme x:Key="Kit.RadioButton" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Foreman.Color.Text}" />
    <Setter Property="FontSize" Value="{DynamicResource Foreman.Type.Body.FontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource Foreman.Type.Body.FontWeight}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="kit:FocusRing.IsEnabled" Value="True" />
    <Setter Property="kit:FocusRing.CornerRadius" Value="{DynamicResource Foreman.Radius.Pill}" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Foreman.Size.SelectionLabelGap}">
          <Border x:Name="PART_Box"
                  Width="{DynamicResource Foreman.Size.CheckBox}"
                  Height="{DynamicResource Foreman.Size.CheckBox}"
                  CornerRadius="{DynamicResource Foreman.Radius.Pill}"
                  Background="{DynamicResource Foreman.Color.WellBackground}"
                  BorderBrush="{DynamicResource Foreman.Color.BorderStrong}"
                  BorderThickness="1">
            <Ellipse x:Name="PART_Dot"
                     Width="{DynamicResource Foreman.Size.RadioDot}"
                     Height="{DynamicResource Foreman.Size.RadioDot}"
                     Fill="{DynamicResource Foreman.Color.Accent}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsVisible="False" />
          </Border>
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"
                             IsVisible="{TemplateBinding Content, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:checked /template/ Border#PART_Box">
      <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.Accent}" />
    </Style>
    <Style Selector="^:checked /template/ Ellipse#PART_Dot">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^:pointerover /template/ Border#PART_Box">
      <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.Accent}" />
    </Style>

    <Style Selector="^:checked:pressed /template/ Border#PART_Box">
      <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.AccentPressed}" />
    </Style>
    <Style Selector="^:checked:pressed /template/ Ellipse#PART_Dot">
      <Setter Property="Fill" Value="{DynamicResource Foreman.Color.AccentPressed}" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{DynamicResource Foreman.Opacity.Disabled}" />
    </Style>

    <!-- Gallery-only: mirrors the real :pointerover/:checked:pressed Setters since Avalonia won't let outside code set them. -->
    <Style Selector="^.gallery-hover /template/ Border#PART_Box">
      <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.Accent}" />
    </Style>
    <Style Selector="^.gallery-pressed /template/ Border#PART_Box">
      <Setter Property="BorderBrush" Value="{DynamicResource Foreman.Color.AccentPressed}" />
    </Style>
    <Style Selector="^.gallery-pressed /template/ Ellipse#PART_Dot">
      <Setter Property="Fill" Value="{DynamicResource Foreman.Color.AccentPressed}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
