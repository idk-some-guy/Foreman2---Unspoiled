# Sourced by packaging/build-app.sh and packaging/verify-bundle.sh when present at packaging/
# on the same branch. Switches the macOS bundle from the Ported identity to the Unspoiled one.
# Only main-unspoiled carries this file at packaging/unspoiled.env; parity has no such file, so
# both scripts fall back to their ported defaults there untouched.
BUNDLE_ID="io.idksome.foreman2.unspoilt"
ICON_FILE="Foreman2-unspoiled.icns"
